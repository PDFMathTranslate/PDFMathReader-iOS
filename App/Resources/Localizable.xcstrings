    "settings.autoAlignDocumentWidthHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الفتح، يضبط مقياس الصفحات على أكثر عرض شائع للصفحات ويحفظ التغييرات في الملف المصدر."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت الفتح، بيكبّر أو يصغّر الصفحات على أكتر عرض شائع وبيحفظ التغييرات في الملف الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খোলার সময় পৃষ্ঠাগুলিকে সবচেয়ে প্রচলিত পৃষ্ঠার প্রস্থে স্কেল করে এবং পরিবর্তনগুলি উৎস ফাইলে সংরক্ষণ করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert beim Öffnen die Seiten proportional auf die häufigste Seitenbreite und speichert die Änderungen in der Quelldatei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On opening, scales pages to the most common page width and saves the changes to the source file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir, ajusta proporcionalmente las páginas al ancho más frecuente y guarda los cambios en el archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture, redimensionne proportionnellement les pages à la largeur la plus fréquente et enregistre les modifications dans le fichier source."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलते समय पृष्ठों को सबसे सामान्य पृष्ठ चौड़ाई के अनुसार स्केल करता है और बदलाव स्रोत फ़ाइल में सहेजता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書を開く際に各ページを最も多い幅に比例拡大・縮小して保存します。元のファイルが変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 열 때 각 페이지를 가장 흔한 너비로 비례 조정하고 저장합니다. 원본 파일이 변경됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "When e open, e scale pages to the page width wey show pass and save change for source file."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir, dimensiona proporcionalmente as páginas para a largura mais comum e guarda as alterações no ficheiro de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытии пропорционально масштабирует страницы до наиболее распространённой ширины и сохраняет изменения в исходном файле."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھولتے وقت صفحات کو عام ترین صفحے کی چوڑائی کے مطابق پیمانہ کرتا ہے اور تبدیلیاں ماخذ فائل میں محفوظ کرتا ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文档时，将各页等比例缩放至最常见的页面宽度，并保存修改。此功能会修改源文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟文件時，將各頁等比例縮放至最常見的頁面寬度並儲存。此功能會修改原始檔案。"
          }
        }
      }
    },
