    "ios.autoAlignDocumentWidthHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح ملف PDF محلي، يغيّر حجم الصفحات نسبيًا إلى العرض الأكثر شيوعًا في نسخة منفصلة. يظل الملف الأصلي دون تغيير."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح ملف PDF محلي، بيكبّر أو يصغّر الصفحات نسبيًا للعرض الأكثر شيوعًا في نسخة منفصلة. الملف الأصلي بيفضل زي ما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় PDF খুললে, আলাদা একটি কপিতে পৃষ্ঠাগুলিকে সবচেয়ে প্রচলিত প্রস্থে আনুপাতিকভাবে স্কেল করা হয়। মূলটি অপরিবর্তিত থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Öffnen einer lokalen PDF werden die Seiten in einer separaten Kopie proportional auf die häufigste Breite skaliert. Das Original bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When opening a local PDF, proportionally scales pages to the most common width in a separate copy. The original stays unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir un PDF local, ajusta proporcionalmente las páginas al ancho más frecuente en una copia separada. El original no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’ouverture d’un PDF local, redimensionne proportionnellement les pages à la largeur la plus fréquente dans une copie séparée. L’original reste inchangé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय PDF खोलते समय, पृष्ठों को एक अलग प्रति में सबसे सामान्य चौड़ाई के अनुसार आनुपातिक रूप से स्केल किया जाता है। मूल अपरिवर्तित रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルPDFを開くと、ページを別のコピーで最も一般的な幅に比例して調整します。元のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 PDF를 열 때 페이지를 별도 복사본에서 가장 일반적인 너비에 맞춰 비례 조정합니다. 원본은 변경되지 않습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open local PDF, e go scale pages proportionally to the width wey show pass inside separate copy. Original no go change."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir um PDF local, dimensiona proporcionalmente as páginas para a largura mais comum numa cópia separada. O original permanece inalterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытии локального PDF пропорционально масштабирует страницы до наиболее распространённой ширины в отдельной копии. Оригинал остаётся без изменений."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی PDF کھولتے وقت، صفحات کو علیحدہ نقل میں عام ترین چوڑائی کے مطابق متناسب طور پر اسکیل کیا جاتا ہے۔ اصل فائل میں کوئی تبدیلی نہیں ہوتی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开本地 PDF 时，会在单独的副本中将各页等比例缩放至最常见的宽度。原文件保持不变。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟本機 PDF 時，會在獨立副本中將各頁等比例縮放至最常見的寬度。原始檔案保持不變。"
          }
        }
      }
    },
    "ios.apiKeyStorage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن مفتاح API في سلسلة مفاتيح iOS ولا يُكتب مطلقًا في التفضيلات."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API بيتخزن في iOS Keychain ومش بيتكتب أبدًا في التفضيلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "API কী iOS Keychain-এ সংরক্ষিত থাকে এবং কখনও preferences-এ লেখা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel wird im iOS Keychain gespeichert und niemals in den Einstellungen abgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is stored in the iOS Keychain and is never written to preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de API se almacena en el iOS Keychain y nunca se escribe en las preferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API est stockée dans l’iOS Keychain et n’est jamais écrite dans les préférences."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API कुंजी iOS Keychain में संग्रहीत है और इसे प्राथमिकताओं में कभी नहीं लिखा जाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーは iOS Keychain に保存され、環境設定には書き込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 iOS Keychain에 저장되며 환경설정에는 기록되지 않습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "API key dey inside iOS Keychain and e no dey write for preferences."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave API é armazenada no iOS Keychain e nunca é escrita nas preferências."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API хранится в iOS Keychain и никогда не записывается в настройках."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "API کلید iOS Keychain میں محفوظ ہوتی ہے اور ترجیحات میں کبھی نہیں لکھی جاتی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥存储在 iOS Keychain 中，绝不会写入偏好设置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "API 金鑰儲存在 iOS Keychain 中，絕不會寫入偏好設定。"
          }
        }
      }
    },
