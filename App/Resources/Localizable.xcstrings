    "error.thisPDFUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف PDF هذا غير متاح. ربما نُقل أو حُذف."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "الـ PDF ده مش متاح. ممكن يكون اتنقل أو اتمسح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই PDF পাওয়া যাচ্ছে না। এটি সরানো বা মুছে ফেলা হয়ে থাকতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
