    "advanced.options.auto_enable_ocr_workaround.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين حلّ توافق OCR تلقائيًا للمستندات الممسوحة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل حلّ توافق OCR تلقائيًا للمستندات الممسوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করা নথির জন্য OCR সমাধান স্বয়ংক্রিয়ভাবে চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die OCR-Umgehung für gescannte Dokumente automatisch aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically enable the OCR workaround for scanned documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar automáticamente la solución OCR para documentos escaneados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer automatiquement le contournement OCR pour les documents numérisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन किए गए दस्तावेज़ों के लिए OCR समाधान अपने आप चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン文書で OCR 回避策を自動的に有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 문서에 OCR 우회 처리를 자동으로 활성화합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn OCR workaround on by itself for scanned documents."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar automaticamente o contorno de OCR para documentos digitalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически включать обходное решение для OCR для сканированных документов."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکین شدہ دستاویزات کے لیے OCR حل خودکار طور پر فعال کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动为扫描文档启用 OCR 兼容处理。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動為掃描文件啟用 OCR 相容處理。"
          }
        }
      }
    },
