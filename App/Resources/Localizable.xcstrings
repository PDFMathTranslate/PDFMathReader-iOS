    "advanced.options.no_merge_alternating_line_numbers.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معالجة أرقام الأسطر والفقرات النصية المتناوبة في المستندات التي تحتوي على أرقام أسطر."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "اتعامل مع أرقام السطور وفقرات النص المتبادلة في المستندات اللي فيها أرقام سطور."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইন নম্বর থাকা নথিতে পালাক্রমিক লাইন নম্বর ও লেখার অনুচ্ছেদ সামলান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselnde Zeilennummern und Textabsätze in Dokumenten mit Zeilennummern verarbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle alternating line numbers and text paragraphs in documents with line numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionar los números de línea alternos y los párrafos de texto en documentos con números de línea."
