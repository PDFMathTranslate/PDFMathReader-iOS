    "settings.bionicReadingHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل بداية كل كلمة غامقة لتوجيه نظرك. الأحرف الثابتة تُغمّق العدد نفسه من الأحرف في كل كلمة، وجذور الكلمات تُغمّق كل كلمة إنجليزية حتى جذرها."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بيخلّي أول كل كلمة تقيل عشان يوجّه عينك. الحروف الثابتة بتتقّل نفس عدد الحروف في كل كلمة، وجذور الكلمات بتتقّل كل كلمة إنجليزي لحد جذرها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চোখকে পথ দেখাতে প্রতিটি শব্দের শুরু বোল্ড করে। নির্দিষ্ট অক্ষর প্রতিটি শব্দে সমান সংখ্যক অক্ষর বোল্ড করে; শব্দমূল প্রতিটি ইংরেজি শব্দকে তার মূল পর্যন্ত বোল্ড করে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt den Anfang jedes Wortes fett hervor, um den Blick zu führen. Feste Zeichenzahl hebt in jedem Wort gleich viele Buchstaben hervor; Wortstämme hebt jedes englische Wort bis zu seinem Stamm hervor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bold the start of each word to guide your eyes. Fixed characters bolds the same number of letters in every word; word roots bolds each English word up to its root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone en negrita el inicio de cada palabra para guiar la vista. Caracteres fijos resalta el mismo número de letras en cada palabra; raíces resalta cada palabra inglesa hasta su raíz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en gras le début de chaque mot pour guider le regard. Caractères fixes met en gras le même nombre de lettres dans chaque mot ; racines met en gras chaque mot anglais jusqu’à sa racine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़र को राह दिखाने के लिए हर शब्द की शुरुआत बोल्ड करता है। निश्चित अक्षर हर शब्द में उतने ही अक्षर बोल्ड करता है; शब्द-मूल हर अंग्रेज़ी शब्द को उसके मूल तक बोल्ड करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各単語の先頭を太字にして視線を導きます。「固定文字数」はすべての単語で同じ文字数を太字にし、「語根」は英単語を語根まで太字にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단어의 앞부분을 굵게 표시해 시선을 안내합니다. 고정 글자 수는 모든 단어에서 같은 수의 글자를, 어근은 영어 단어를 어근까지 굵게 표시합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey make the start of every word bold so your eye fit follow am. Fixed characters dey bold the same number of letters for every word; word roots dey bold every English word reach im root."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca em negrito o início de cada palavra para guiar o olhar. Caracteres fixos destaca o mesmo número de letras em cada palavra; raízes destaca cada palavra em inglês até a sua raiz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяет начало каждого слова жирным, чтобы направлять взгляд. «Фиксированное число букв» выделяет одинаковое число букв в каждом слове; «корни слов» выделяет английские слова до корня."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نظر کی رہنمائی کے لیے ہر لفظ کا آغاز بولڈ کرتا ہے۔ مقررہ حروف ہر لفظ میں اتنے ہی حروف بولڈ کرتا ہے؛ لفظی جڑیں ہر انگریزی لفظ کو اس کی جڑ تک بولڈ کرتی ہیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "加粗每个词的开头以引导视线。“固定字符”在每个词中加粗相同数量的字母；“词根”将每个英文单词加粗到其词根。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加粗每個詞的開頭以引導視線。「固定字元」在每個詞中加粗相同數量的字母；「詞根」將每個英文單字加粗到其詞根。"
          }
        }
      }
    },
