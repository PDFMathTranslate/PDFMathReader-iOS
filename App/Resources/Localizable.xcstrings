    "kernelRecovery.bundled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النواة مضمّنة مع التطبيق. أعد تثبيت التطبيق أو حدّثه لإعادة بنائها."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "النواة دي جاية مع التطبيق. نزّل التطبيق تاني أو حدّثه عشان تتبني من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কার্নেলটি অ্যাপের সঙ্গে আছে। এটি নতুন করে তৈরি করতে অ্যাপটি আবার ইনস্টল বা আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kernel ist in der App enthalten. Installieren Sie die App neu oder aktualisieren Sie sie, um ihn neu zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This kernel is bundled with the app. Reinstall or update the app to rebuild it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este núcleo está integrado en la aplicación. Reinstale o actualice la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce noyau est intégré à l’application. Réinstallez ou mettez à jour l’application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कर्नेल ऐप में शामिल है। इसे फिर बनाने के लिए ऐप फिर स्थापित करें या अपडेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカーネルはアプリに同梱されています。再インストールまたは更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커널은 앱에 포함되어 있습니다. 앱을 재설치하거나 업데이트하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This kernel come with app. Install or update the app make e build am again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este kernel está incluído na aplicação. Reinstale ou atualize a aplicação para o reconstruir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ядро входит в приложение. Переустановите или обновите приложение, чтобы пересобрать его."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کرنل ایپ کے ساتھ شامل ہے۔ اسے دوبارہ بنانے کے لیے ایپ دوبارہ انسٹال یا اپ ڈیٹ کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此内核随应用内置；请重新安装或更新应用以重建。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此核心隨應用程式內建；請重新安裝或更新應用程式以重建。"
          }
        }
      }
    },
