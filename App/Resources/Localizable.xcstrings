          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 모드 단락 간격 최적화"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Make paragraph gaps better for reading mode"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Otimizar espaços entre parágrafos no modo de leitura"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оптимизировать интервалы между абзацами в режиме чтения"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مطالعے کے موڈ میں پیراگراف کے وقفے بہتر کریں"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读模式段落间隙优化"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀模式段落間距最佳化"
          }
        }
      }
    },
    "settings.optimizeParagraphGapsDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع القراءة العمودي، قلّل الفواصل الإضافية لاستخدام مساحة الشاشة بكفاءة أكبر."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع القراءة الرأسي، قلّل المسافات الزيادة عشان تستفيد من مساحة الشاشة أكتر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্লম্ব পঠন মোডে অতিরিক্ত ফাঁক কমিয়ে পর্দার জায়গা আরও দক্ষভাবে ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im vertikalen Lesemodus zusätzliche Abstände verringern, um den Bildschirmplatz effizienter zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In vertical reading mode, reduce extra gaps to use screen space more efficiently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo de lectura vertical, reduce los espacios adicionales para aprovechar mejor la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode lecture vertical, réduire les espaces superflus pour mieux utiliser l’écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबवत पठन मोड में अतिरिक्त अंतराल घटाकर स्क्रीन स्थान का अधिक कुशल उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦書きの読書モードで余分な間隔を縮め、画面をより有効に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세로 읽기 모드에서 추가 간격을 줄여 화면 공간을 더 효율적으로 사용합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "For vertical reading mode, reduce extra gaps so screen space work better."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de leitura vertical, reduzir espaços adicionais para utilizar o ecrã de forma mais eficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вертикальном режиме чтения уменьшать лишние интервалы, чтобы эффективнее использовать место на экране."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عمودی مطالعے کے موڈ میں اضافی وقفے کم کر کے اسکرین کی جگہ زیادہ مؤثر طور پر استعمال کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在竖向阅读模式中，通过缩减额外的间隙在排版中充分利用屏幕空间。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在直向閱讀模式中，縮減額外間距，讓排版更充分利用螢幕空間。"
          }
        }
      }
    },
