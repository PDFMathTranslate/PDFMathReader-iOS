    "settings.emphasizeTopicSentencesHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضع تلوين خفيف علامة على الجملة الأولى من الفقرات التي تتجاوز 60 كلمة أو 120 محرفًا من محارف CJK. تُتخطى الفقرات المؤلفة من جملة واحدة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "لون خفيف بيعلّم أول جملة في الفقرات اللي أطول من 60 كلمة أو 120 حرف CJK. الفقرات اللي فيها جملة واحدة بتتخطى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "60টি শব্দ বা 120টি CJK অক্ষরের বেশি দীর্ঘ অনুচ্ছেদের প্রথম বাক্য হালকা রঙে চিহ্নিত করে। এক-বাক্যের অনুচ্ছেদ বাদ থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dezente Tönung markiert den ersten Satz von Absätzen mit mehr als 60 Wörtern oder 120 CJK-Zeichen. Absätze mit nur einem Satz werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft tint marks the first sentence of paragraphs over 60 words or 120 CJK characters. Single-sentence paragraphs are skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fondo suave marca la primera oración de párrafos de más de 60 palabras o 120 caracteres CJK. Se omiten los párrafos de una sola oración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une teinte légère marque la première phrase des paragraphes de plus de 60 mots ou 120 caractères CJK. Les paragraphes à une seule phrase sont exclus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "60 शब्दों या 120 CJK वर्णों से बड़े अनुच्छेदों के पहले वाक्य को हल्के रंग से चिह्नित करता है। एक-वाक्य वाले अनुच्छेद छोड़ दिए जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "60語または120文字を超える段落の最初の文を淡く表示します。1文のみの段落は対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "60단어 또는 한중일 문자 120자를 넘는 문단의 첫 문장을 옅게 표시합니다. 한 문장인 문단은 제외합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Light colour marks first sentence for paragraph wey pass 60 words or 120 CJK characters. If paragraph get one sentence, e no mark am."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tonalidade suave marca a primeira frase de parágrafos com mais de 60 palavras ou 120 caracteres CJK. Parágrafos com uma só frase são ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая заливка отмечает первое предложение абзацев длиннее 60 слов или 120 иероглифов CJK. Абзацы из одного предложения пропускаются."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "60 الفاظ یا 120 CJK حروف سے بڑے پیراگراف کے پہلے جملے کو ہلکے رنگ سے نشان زد کرتا ہے۔ ایک جملے والے پیراگراف چھوڑ دیے جاتے ہیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "以淡色底纹标示超过 60 个词或 120 个中日韩字符的长段落首句；只有一句的段落不强调。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以淡色底紋標示超過 60 個詞或 120 個中日韓字元的長段落首句；只有一句的段落不強調。"
          }
        }
      }
    },
