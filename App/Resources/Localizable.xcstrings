    "ios.recentClearCacheMessage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد مسح الترجمات المخزنة مؤقتًا لملف PDF هذا؟ سيبقى ملف PDF وتقدّم القراءة محفوظين."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "تمسح الترجمات المحفوظة مؤقتًا للـ PDF ده؟ ملف الـ PDF وتقدّم القراءة بتوعك هيفضلوا محفوظين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই PDF-এর ক্যাশ করা অনুবাদ মুছবেন? আপনার PDF এবং পড়ার অগ্রগতি সংরক্ষিত থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeicherte Übersetzungen für dieses PDF löschen? Ihr PDF und Lesefortschritt bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear cached translations for this PDF? Your PDF and reading progress will be preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar las traducciones almacenadas en caché de este PDF? El PDF y tu progreso de lectura se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les traductions mises en cache pour ce PDF ? Votre PDF et votre progression de lecture seront conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या इस PDF के कैश किए गए अनुवाद साफ़ करें? आपका PDF और पढ़ने की प्रगति सुरक्षित रहेगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PDF のキャッシュされた翻訳を消去しますか？PDF と読書の進捗は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PDF의 캐시된 번역을 지우겠습니까? PDF와 읽기 진행 상황은 유지됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear cached translations for this PDF? Your PDF and reading progress go remain safe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar as traduções em cache deste PDF? O PDF e o progresso de leitura serão preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить кэшированные переводы этого PDF? PDF и прогресс чтения будут сохранены."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس PDF کے کیش شدہ تراجم صاف کریں؟ آپ کی PDF اور مطالعے کی پیش رفت محفوظ رہے گی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此 PDF 的缓存翻译？您的 PDF 和阅读进度将得到保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除這份 PDF 的快取翻譯嗎？您的 PDF 與閱讀進度會保留。"
          }
        }
      }
    },
