    "ios.addGlossaryDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مسردًا للاحتفاظ بالترجمات المفضلة للمصطلحات المتكررة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "ضيف مسرد عشان تحتفظ بالترجمات المفضلة للمصطلحات اللي بتتكرر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বারবার ব্যবহৃত শব্দের পছন্দের অনুবাদ রাখতে একটি শব্দকোষ যোগ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein Glossar hinzu, um bevorzugte Übersetzungen für wiederkehrende Begriffe zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a glossary to keep preferred translations for recurring terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un glosario para conservar traducciones preferidas de términos recurrentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un glossaire pour conserver les traductions préférées des termes récurrents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बार-बार आने वाले शब्दों के पसंदीदा अनुवाद रखने के लिए शब्दावली जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返し使う用語の優先訳を保持するため、用語集を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복되는 용어의 선호 번역을 유지하려면 용어집을 추가하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Add glossary make you keep preferred translation for terms wey dey repeat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um glossário para guardar traduções preferidas de termos recorrentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте глоссарий, чтобы сохранять предпочтительные переводы повторяющихся терминов."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بار بار آنے والی اصطلاحات کے پسندیدہ تراجم محفوظ رکھنے کے لیے لغت شامل کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加术语表，以保存重复术语的首选译法。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "加入術語表，以保留重複術語的偏好翻譯。"
          }
        }
      }
    },
