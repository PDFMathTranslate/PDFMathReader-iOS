          "stringUnit": {
            "state": "translated",
            "value": "يتعذر الوصول إلى حاسوبك. تحقق من أن PDFMathReader مفتوح وأن مشاركة المستندات مفعّلة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "مش قادر أوصل للكمبيوتر بتاعك. اتأكد إن PDFMathReader مفتوح وإن مشاركة المستندات شغالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কম্পিউটারে পৌঁছানো যাচ্ছে না। PDFMathReader খোলা আছে এবং document sharing চালু আছে কি না দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Computer ist nicht erreichbar. Vergewissern Sie sich, dass PDFMathReader geöffnet ist und die Dokumentfreigabe aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t reach your computer. Check that PDFMathReader is open and document sharing is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al ordenador. Comprueba que PDFMathReader esté abierto y que el uso compartido de documentos esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’atteindre votre ordinateur. Vérifiez que PDFMathReader est ouvert et que le partage de documents est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके computer तक नहीं पहुँच पा रहे हैं। जाँचें कि PDFMathReader खुला है और document sharing चालू है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータに接続できません。PDFMathReader が開いており、document sharing が有効になっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에 연결할 수 없습니다. PDFMathReader가 열려 있고 document sharing이 켜져 있는지 확인하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We no fit reach your computer. Make sure PDFMathReader dey open and document sharing dey on."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aceder ao computador. Verifique se o PDFMathReader está aberto e se a partilha de documentos está ativada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся подключиться к компьютеру. Убедитесь, что PDFMathReader открыт, а общий доступ к документам включён."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کمپیوٹر تک رسائی نہیں ہو سکی۔ یقینی بنائیں کہ PDFMathReader کھلا ہے اور دستاویز شیئرنگ فعال ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到你的电脑。请确认 PDFMathReader 已打开且 document sharing 已开启。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到你的電腦。請確認 PDFMathReader 已開啟，且 document sharing 已啟用。"
          }
        }
      }
    },
