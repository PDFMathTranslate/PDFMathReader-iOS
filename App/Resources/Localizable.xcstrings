    "ios.glossaryInstructions": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقة العبارات الدقيقة حساسة لحالة الأحرف. تُطبّق أطول مطابقة على الترجمات الجديدة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقة العبارة بالحرف حساسة لحالة الحروف. أطول مطابقة بتتطبق على الترجمات الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক বাক্যাংশ মেলানো বড়-ছোট হাতের অক্ষরনির্ভর। নতুন অনুবাদে সবচেয়ে দীর্ঘ মিল প্রয়োগ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übereinstimmung exakter Phrasen unterscheidet Groß- und Kleinschreibung. Für neue Übersetzungen wird die längste Übereinstimmung verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact phrase matching is case sensitive. The longest match applies to new translations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coincidencia de frases exactas distingue mayúsculas y minúsculas. Se aplica la coincidencia más larga a las nuevas traducciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correspondance des expressions exactes respecte la casse. La correspondance la plus longue s’applique aux nouvelles traductions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक वाक्यांश मिलान अक्षर-स्थिति के प्रति संवेदनशील है। नए अनुवादों पर सबसे लंबा मिलान लागू होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全一致では大文字と小文字が区別されます。新しい翻訳には最長一致が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 구문 일치는 대소문자를 구분합니다. 새 번역에는 가장 긴 일치 항목이 적용됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact phrase match dey mind capital letters. Longest match go apply to new translations."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A correspondência exata de frases diferencia maiúsculas e minúsculas. A correspondência mais longa aplica-se às novas traduções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При точном сопоставлении учитывается регистр. Для новых переводов применяется самое длинное совпадение."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عین فقرے کی مطابقت حروف کے بڑے یا چھوٹے ہونے سے حساس ہے۔ نئے تراجم پر سب سے طویل مطابقت لاگو ہوتی ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "精确短语匹配区分大小写。新译文使用最长匹配。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "精確片語比對會區分大小寫。新翻譯會套用最長的比對結果。"
          }
        }
      }
    },
