    "ios.computerKernelDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل «سريع» و«دقيق» على حاسوبك عبر الشبكة المحلية، ويعودان إلى «فائق السرعة» عند عدم توفره. على حاسوبك، اختر Translation › Share Kernels with iPhone and iPad… لعرض العنوان ورمز الإقران. تُرسل الصفحات كملفات PDF من صفحة واحدة ولا تحتوي على طبقة نص للقراءة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "«سريع» و«دقيق» بيشتغلوا على الكمبيوتر بتاعك عن طريق الشبكة المحلية، وبيتحولوا لـ«سريع جدًا» لو مش متاح. على الكمبيوتر، اختار Translation › Share Kernels with iPhone and iPad… عشان تشوف العنوان وكود الاقتران. الصفحات بتتبعت كملفات PDF من صفحة واحدة ومن غير طبقة نص للقراءة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ও নির্ভুল মোড স্থানীয় নেটওয়ার্কের মাধ্যমে আপনার কম্পিউটারে চলে এবং এটি অনুপলব্ধ হলে অতি দ্রুত মোডে ফিরে যায়। ঠিকানা ও পেয়ারিং কোড দেখতে আপনার কম্পিউটারে Translation › Share Kernels with iPhone and iPad… বেছে নিন। পৃষ্ঠাগুলি এক-পৃষ্ঠার PDF হিসেবে পাঠানো হয় এবং এতে পড়ার টেক্সট স্তর থাকে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und Präzise laufen über das lokale Netzwerk auf Ihrem Computer und wechseln zu Extrem schnell, wenn er nicht verfügbar ist. Wählen Sie auf Ihrem Computer Translation › Share Kernels with iPhone and iPad…, um Adresse und Kopplungscode anzuzeigen. Seiten werden als einseitige PDFs gesendet und haben keine Leseebene mit Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise run on your computer over the local network and fall back to Ultra fast when it is unavailable. On your computer, choose Translation › Share Kernels with iPhone and iPad… to see the address and pairing code. Pages are sent as one-page PDFs and have no reading text layer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido y Preciso se ejecutan en tu ordenador a través de la red local y recurren a Ultrarrápido cuando no está disponible. En tu ordenador, elige Translation › Share Kernels with iPhone and iPad… para ver la dirección y el código de vinculación. Las páginas se envían como PDF de una página y no tienen capa de texto de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide et Précis s’exécutent sur votre ordinateur via le réseau local et reviennent à Ultra-rapide lorsqu’il est indisponible. Sur votre ordinateur, choisissez Translation › Share Kernels with iPhone and iPad… pour afficher l’adresse et le code de jumelage. Les pages sont envoyées sous forme de PDF d’une page et n’ont pas de couche de texte de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ और सटीक मोड स्थानीय नेटवर्क पर आपके कंप्यूटर पर चलते हैं और उपलब्ध न होने पर अति-तेज़ मोड पर लौटते हैं। पता और पेयरिंग कोड देखने के लिए अपने कंप्यूटर पर Translation › Share Kernels with iPhone and iPad… चुनें। पृष्ठ एक-पृष्ठ PDF के रूप में भेजे जाते हैं और उनमें पढ़ने के लिए टेक्स्ट परत नहीं होती।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「高速」と「高精度」はローカルネットワーク経由でお使いのコンピュータ上で実行され、利用できない場合は「超高速」に戻ります。アドレスとペアリングコードを表示するには、コンピュータで Translation › Share Kernels with iPhone and iPad… を選択してください。ページは 1 ページの PDF として送信され、読書用テキストレイヤーはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠름 및 정밀 모드는 로컬 네트워크를 통해 컴퓨터에서 실행되며, 사용할 수 없으면 매우 빠름으로 전환합니다. 주소와 페어링 코드를 보려면 컴퓨터에서 Translation › Share Kernels with iPhone and iPad…을(를) 선택하세요. 페이지는 한 페이지짜리 PDF로 전송되며 읽기용 텍스트 레이어가 없습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise dey run for your computer through local network; if e no dey available, e go use Ultra fast. For your computer, choose Translation › Share Kernels with iPhone and iPad… to see the address and pairing code. Pages dey go as one-page PDF and dem no get reading text layer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e Preciso são executados no seu computador através da rede local e recorrem a Ultrarrápido quando este não está disponível. No seu computador, escolha Translation › Share Kernels with iPhone and iPad… para ver o endereço e o código de emparelhamento. As páginas são enviadas como PDF de uma página e não têm camada de texto de leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы «Быстрый» и «Точный» работают на вашем компьютере через локальную сеть и переключаются на «Сверхбыстрый», если он недоступен. Чтобы увидеть адрес и код сопряжения, выберите на компьютере Translation › Share Kernels with iPhone and iPad…. Страницы отправляются как одностраничные PDF и не содержат текстового слоя для чтения."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیز اور درست موڈ مقامی نیٹ ورک کے ذریعے آپ کے کمپیوٹر پر چلتے ہیں، اور دستیاب نہ ہونے پر انتہائی تیز موڈ پر واپس آتے ہیں۔ پتہ اور پیئرنگ کوڈ دیکھنے کے لیے اپنے کمپیوٹر پر Translation › Share Kernels with iPhone and iPad… منتخب کریں۔ صفحات ایک صفحے کی PDF کے طور پر بھیجے جاتے ہیں اور ان میں پڑھنے کی متنی تہہ نہیں ہوتی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“快速”和“精确”通过局域网在你的电脑上运行；不可用时回退到“超快”。在电脑上选择“Translation › Share Kernels with iPhone and iPad…”即可查看地址和配对码。页面以单页 PDF 发送，没有阅读文本层。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「快速」和「精確」會透過區域網路在你的電腦上執行；無法使用時會改用「超快」。在電腦上選擇「Translation › Share Kernels with iPhone and iPad…」即可查看位址和配對碼。頁面以單頁 PDF 傳送，沒有閱讀文字層。"
          }
        }
      }
    },
