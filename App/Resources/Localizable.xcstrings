    "ios.searchingComputers": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البحث عن أجهزة Tailscale القريبة والمحفوظة… فعّل Auto-discovery ومشاركة النوى على حاسوبك."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بيتم البحث عن كمبيوترات Tailscale القريبة واللي محفوظة… فعّل Auto-discovery ومشاركة النوى على الكمبيوتر بتاعك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছাকাছি এবং মনে রাখা Tailscale কম্পিউটার খোঁজা হচ্ছে… আপনার কম্পিউটারে Auto-discovery ও kernel sharing চালু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Computern in der Nähe und gemerkten Tailscale-Computern … Aktivieren Sie Auto-discovery und die Kernel-Freigabe auf Ihrem Computer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching nearby and remembered Tailscale computers… Enable Auto-discovery and kernel sharing on your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando ordenadores Tailscale cercanos y recordados… Activa Auto-discovery y el uso compartido de kernels en tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche d’ordinateurs Tailscale à proximité et mémorisés… Activez Auto-discovery et le partage des noyaux sur votre ordinateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़दीकी और याद रखे गए Tailscale कंप्यूटर खोजे जा रहे हैं… अपने कंप्यूटर पर Auto-discovery और kernel sharing चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにある、または記憶された Tailscale コンピュータを検索中… コンピュータで Auto-discovery とカーネル共有を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 및 기억된 Tailscale 컴퓨터 검색 중… 컴퓨터에서 Auto-discovery와 커널 공유를 활성화하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Search dey find nearby Tailscale computers and ones wey you remember… Turn on Auto-discovery and kernel sharing for your computer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A procurar computadores Tailscale próximos e memorizados… Ative Auto-discovery e a partilha de kernels no seu computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск ближайших и сохранённых компьютеров Tailscale… Включите Auto-discovery и общий доступ к ядрам на компьютере."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریب اور یاد رکھے گئے Tailscale کمپیوٹرز تلاش کیے جا رہے ہیں… اپنے کمپیوٹر پر Auto-discovery اور kernel sharing کو آن کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在搜索附近及已记住的 Tailscale 电脑… 请在电脑上启用 Auto-discovery 和内核共享。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "正在搜尋附近及已記住的 Tailscale 電腦… 請在電腦上啟用 Auto-discovery 和核心分享。"
          }
        }
      }
    },
