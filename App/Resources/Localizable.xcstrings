    "settings.defaultPageCropHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبّق عند فتح مستندات لا تحتوي على قص محفوظ. يقص بالتساوي من الجانبين، بحد أقصى 50% إجمالًا في كل اتجاه. لا يغيّر الملف المصدر."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بيشتغل لما تفتح مستند مفيهوش قص محفوظ. بيقص بالتساوي من الناحيتين، لحد 50% إجمالًا في كل اتجاه. مش بيغيّر الملف الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত কাটছাঁট ছাড়া নথি খোলার সময় প্রযোজ্য। দুই পাশ থেকে সমানভাবে কাটে, প্রতিটি দিকে মোট 50% পর্যন্ত। উৎস ফাইল বদলায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Öffnen von Dokumenten ohne gespeicherten Ausschnitt angewendet. Schneidet in jeder Richtung gleichmäßig von beiden Seiten ab, insgesamt höchstens 50 %. Die Quelldatei wird nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies when opening documents without a saved crop. Crops equally from both sides, up to 50% in total per direction. Does not change the source file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al abrir documentos sin recorte guardado. Recorta ambos lados por igual, hasta un 50 % en total por dirección. No modifica el archivo original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué à l’ouverture sans recadrage enregistré. Retire une part égale des deux côtés, au maximum 50 % au total par direction. Le fichier source reste inchangé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी हुई क्रॉप सेटिंग के बिना दस्तावेज़ खोलने पर लागू होता है। दोनों दिशाओं में दोनों किनारों से बराबर क्रॉप करता है, हर दिशा में कुल 50% तक। स्रोत फ़ाइल नहीं बदलता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの切り抜き設定がない文書を開く際に適用。各方向の両端を均等に、合計50%まで切り抜きます。元のファイルは変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자르기 설정이 없는 문서를 열 때 적용됩니다. 각 방향의 양쪽을 균등하게 총 50%까지 자릅니다. 원본 파일은 변경하지 않습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E apply when document open without saved crop. E crop equal from both sides, up to 50% total for each direction. Source file no change."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao abrir documentos sem corte guardado. Corta igualmente de ambos os lados, até 50% no total por direção. Não altera o ficheiro de origem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется при открытии документов без сохранённых параметров обрезки. Обрезает с обеих сторон поровну, всего не более 50 % в каждом направлении. Исходный файл не изменяется."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ تراش کے بغیر دستاویز کھولنے پر لاگو ہوتا ہے۔ دونوں طرف سے یکساں تراشتا ہے، ہر سمت میں کل 50% تک۔ ماخذ فائل تبدیل نہیں ہوتی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "打开没有已保存裁剪设置的文档时生效。横向、纵向均从两侧等量裁剪，每个方向合计不超过 50%。不影响源文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟沒有已儲存裁剪設定的文件時生效。橫向、縱向均從兩側等量裁剪，每個方向合計不超過 50%。不影響原始檔案。"
          }
        }
      }
    },
