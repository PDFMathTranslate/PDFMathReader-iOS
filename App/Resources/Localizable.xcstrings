    "ios.disclosureAppleOnDevice": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Apple Translation على هذا الجهاز؛ لا يُرسل نص المستند إلى خادم ترجمة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation بتشتغل على الجهاز ده؛ نص المستند مش بيتبعت لسيرفر ترجمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation এই ডিভাইসেই চলে; নথির লেখা কোনো অনুবাদ সার্ভারে পাঠানো হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation läuft auf diesem Gerät; Dokumenttext wird nicht an einen Übersetzungsserver gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation runs on this device; document text is not sent to a translation server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation se ejecuta en este dispositivo; el texto del documento no se envía a un servidor de traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation s’exécute sur cet appareil ; le texte du document n’est pas envoyé à un serveur de traduction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation इस डिवाइस पर चलता है; दस्तावेज़ का टेक्स्ट किसी अनुवाद सर्वर को नहीं भेजा जाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation はこのデバイス上で実行され、書類のテキストは翻訳サーバーに送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation은 이 기기에서 실행되며 문서 텍스트는 번역 서버로 전송되지 않습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation dey run for this device; document text no dey go translation server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation é executado neste dispositivo; o texto do documento não é enviado para um servidor de tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation работает на этом устройстве; текст документа не отправляется на сервер перевода."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation اسی ڈیوائس پر چلتا ہے؛ دستاویز کا متن ترجمہ سرور کو نہیں بھیجا جاتا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation 在此设备上运行；文档文本不会发送到翻译服务器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation 在此裝置上執行；文件文字不會傳送至翻譯伺服器。"
          }
        }
      }
    },
    "ios.disclosureFreeProxy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل نص الفقرات من PDF إلى وكيل ترجمة SiliconFlow المجاني."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الفقرات من PDF بيتبعت لوكيل ترجمة SiliconFlow المجاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার PDF-এর অনুচ্ছেদের লেখা বিনামূল্যের SiliconFlow অনুবাদ প্রক্সিতে পাঠানো হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absatztext aus Ihrem PDF wird an den kostenlosen SiliconFlow-Übersetzungsproxy gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragraph text from your PDF is sent to the free SiliconFlow translation proxy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de los párrafos de tu PDF se envía al proxy de traducción gratuito de SiliconFlow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte des paragraphes de votre PDF est envoyé au proxy de traduction gratuit de SiliconFlow."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके PDF का पैराग्राफ़ टेक्स्ट मुफ़्त SiliconFlow अनुवाद प्रॉक्सी को भेजा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF の段落テキストは無料の SiliconFlow 翻訳プロキシに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF의 문단 텍스트가 무료 SiliconFlow 번역 프록시로 전송됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragraph text from your PDF dey go free SiliconFlow translation proxy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto dos parágrafos do seu PDF é enviado para o proxy de tradução gratuito da SiliconFlow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст абзацев из PDF отправляется в бесплатный прокси перевода SiliconFlow."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے PDF کے پیراگراف کا متن مفت SiliconFlow ترجمہ پراکسی کو بھیجا جاتا ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 中的段落文本会发送到免费的 SiliconFlow 翻译代理。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 中的段落文字會傳送至免費的 SiliconFlow 翻譯代理。"
          }
        }
      }
    },
    "ios.disclosureOpenAI": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل نص الفقرات من PDF إلى خادم متوافق مع OpenAI تقوم بتكوينه."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الفقرات من PDF بيتبعت للسيرفر المتوافق مع OpenAI اللي بتختاره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার PDF-এর অনুচ্ছেদের লেখা আপনার কনফিগার করা OpenAI-সঙ্গত সার্ভারে পাঠানো হয়।"
