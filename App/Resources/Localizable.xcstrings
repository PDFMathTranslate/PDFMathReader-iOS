    "ios.clearHistoryMessage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة القائمة الأخيرة والصور المصغّرة المخزنة مؤقتًا. تبقى ملفاتك الأصلية دون تغيير."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "ده بيشيل القائمة الأخيرة والصور الصغيرة المحفوظة مؤقتًا. ملفاتك الأصلية بتفضل زي ما هي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সাম্প্রতিক তালিকা ও ক্যাশ করা থাম্বনেইল সরিয়ে দেয়। আপনার মূল ফাইল অক্ষত থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Liste der zuletzt verwendeten Dokumente und zwischengespeicherte Miniaturen entfernt. Ihre Originaldateien bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the recent list and cached thumbnails. Your original files stay untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la lista de recientes y las miniaturas en caché. Tus archivos originales permanecen intactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime la liste récente et les vignettes en cache. Vos fichiers originaux restent intacts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हाल की सूची और कैश किए गए थंबनेल हट जाते हैं। आपकी मूल फ़ाइलें जस की तस रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使った項目とキャッシュ済みのサムネールを削除します。元のファイルはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 목록과 캐시된 축소판을 제거합니다. 원본 파일은 그대로 유지됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This one remove recent list and cached thumbnail dem. Your original files remain untouched."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove a lista recente e as miniaturas em cache. Os seus ficheiros originais permanecem intactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит список недавних документов и кэшированные миниатюры. Исходные файлы останутся нетронутыми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے حالیہ فہرست اور کیش شدہ تھمب نیلز حذف ہو جائیں گے۔ آپ کی اصل فائلیں محفوظ رہیں گی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除最近列表和缓存的缩略图。原始文件保持不变。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除最近項目列表和快取的縮圖。原始檔案不受影響。"
          }
        }
      }
    },
