            "value": "عدّي تقسيم الخطوط لمجموعات؛ ده ممكن يحسّن التوافق بس بيكبّر ملف الإخراج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফন্ট সাবসেট করা বাদ দিলে সামঞ্জস্য বাড়তে পারে, তবে আউটপুট ফাইল বড় হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrift-Subsetbildung überspringen; dies kann die Kompatibilität verbessern, vergrößert aber die Ausgabedatei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip font subsetting; this may improve compatibility but increases the output file size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir la creación de subconjuntos de fuentes; puede mejorar la compatibilidad, pero aumenta el tamaño del archivo de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer la création de sous-ensembles de polices ; la compatibilité peut s’améliorer, mais le fichier de sortie sera plus volumineux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉन्ट सबसेटिंग छोड़ने से संगतता बढ़ सकती है, लेकिन आउटपुट फ़ाइल बड़ी होगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォントのサブセット化をスキップします。互換性が向上する場合がありますが、出力ファイルが大きくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글꼴 서브세팅을 건너뜁니다. 호환성이 향상될 수 있지만 출력 파일이 커집니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip font subsetting; e fit help compatibility but output file go big."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar subconjuntos de tipos de letra; pode melhorar a compatibilidade, mas aumenta o tamanho do ficheiro de saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропустить создание подмножеств шрифтов; это может повысить совместимость, но увеличит размер выходного файла."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فونٹ سب سیٹنگ چھوڑ دیں؛ اس سے مطابقت بہتر ہو سکتی ہے مگر آؤٹ پٹ فائل بڑی ہو جائے گی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过字体子集化；这可能提高兼容性，但会增大输出文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "略過字型子集化；這可能提升相容性，但會增加輸出檔案大小。"
          }
        }
      }
    },
