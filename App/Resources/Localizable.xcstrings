          "stringUnit": {
            "state": "translated",
            "value": "موجودہ تراجم دوبارہ استعمال کریں"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "沿用已有译文"
          }
        },
