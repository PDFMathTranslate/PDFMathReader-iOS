    "companion.documentsDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ملف PDF كاملاً من الكمبيوتر. عند الانتهاء، أغلقه هنا لتتم مزامنة التعليقات."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ملف PDF كامل من الكمبيوتر. لما تخلص، اقفله هنا عشان التعليقات تتزامن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কম্পিউটার থেকে একটি সম্পূর্ণ PDF খুলুন। কাজ শেষ হলে এখানে বন্ধ করুন, যাতে টীকা সিঙ্ক হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie ein vollständiges PDF von Ihrem Computer. Schließen Sie es hier, wenn Sie fertig sind, damit die Anmerkungen synchronisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a complete PDF from your computer. Close it here when you’re done so annotations sync back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un PDF completo desde su computadora. Cuando termine, ciérrelo aquí para sincronizar las anotaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un PDF complet depuis votre ordinateur. Fermez-le ici lorsque vous avez terminé pour synchroniser les annotations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंप्यूटर से पूरा PDF खोलें। काम पूरा होने पर इसे यहाँ बंद करें, ताकि टिप्पणियाँ सिंक हो जाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータから完全な PDF を開きます。終わったらここで閉じて、注釈を同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 완전한 PDF를 엽니다. 작업을 마치면 여기서 닫아 주석을 동기화하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Open one complete PDF from your computer. When you don finish, close am here make annotations sync back."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um PDF completo do seu computador. Quando terminar, feche-o aqui para sincronizar as anotações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте полный PDF с компьютера. После завершения закройте его здесь, чтобы синхронизировать аннотации."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے کمپیوٹر سے مکمل PDF کھولیں۔ کام ختم ہونے پر اسے یہاں بند کریں تاکہ حاشیے ہم وقت ہو جائیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从电脑打开完整 PDF。完成后请在此关闭文档，以便同步批注。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從電腦開啟完整 PDF。完成後請在此關閉文件，以便同步註解。"
          }
        }
      }
    },
