            "value": "重用現有翻譯"
          }
        }
      }
    },
    "settings.reuseTranslationsDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة استخدام الترجمات المتوافقة للمستند واللغة والنواة والخيارات نفسها عبر الخدمات والنماذج."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الترجمات المتوافقة لنفس المستند واللغة والنواة والخيارات بين الخدمات والموديلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই নথি, ভাষা, কার্নেল ও বিকল্পের জন্য পরিষেবা এবং মডেলজুড়ে সামঞ্জস্যপূর্ণ অনুবাদ আবার ব্যবহার করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatible Übersetzungen für dasselbe Dokument, dieselbe Sprache, denselben Kernel und dieselben Optionen dienst- und modellübergreifend wiederverwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reuse compatible translations for the same document, language, kernel, and options across services and models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutiliza traducciones compatibles del mismo documento, idioma, núcleo y opciones entre servicios y modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réutiliser les traductions compatibles pour le même document, la même langue, le même noyau et les mêmes options entre services et modèles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही दस्तावेज़, भाषा, कर्नेल और विकल्पों के लिए सेवाओं और मॉडलों में संगत अनुवाद फिर उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ文書、言語、カーネル、オプションに互換性がある場合、サービスやモデルをまたいで翻訳を再利用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 문서, 언어, 커널 및 옵션과 호환되는 번역을 서비스와 모델 간에 재사용합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Use translations wey match the same document, language, kernel and options across services and models again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutilizar traduções compatíveis para o mesmo documento, idioma, kernel e opções entre serviços e modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно использовать совместимые переводы одного документа, языка, ядра и параметров между сервисами и моделями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ہی دستاویز، زبان، کرنل اور اختیارات کے لیے مطابقت رکھنے والے تراجم کو مختلف سروسز اور ماڈلز میں دوبارہ استعمال کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "文档、语言、内核和选项兼容时，切换服务或模型后沿用已有译文。关闭后仅使用当前模型的缓存。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在文件、語言、核心與選項相容時，跨翻譯服務與模型重用翻譯。"
          }
        }
      }
    },
