    "ios.resumeReading": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع من حيث توقفت، أو استورد ورقة من الملفات."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "كمّل من مكان ماوقفت، أو استورد ورقة من الملفات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে থেমেছিলেন সেখান থেকে শুরু করুন, অথবা Files থেকে একটি পেপার আমদানি করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahren Sie dort fort, wo Sie aufgehört haben, oder importieren Sie eine Arbeit aus den Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up where you left off, or import a paper from Files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa donde lo dejaste o importa un artículo desde Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez là où vous vous êtes arrêté ou importez un article depuis Fichiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ छोड़ा था वहीं से शुरू करें या Files से कोई पेपर आयात करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の続きから再開するか、「ファイル」から論文を読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단한 곳에서 계속하거나 파일에서 논문을 가져오세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up where you stop, or import paper from Files."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue onde ficou ou importe um artigo a partir de Ficheiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите с того места, где остановились, или импортируйте статью из приложения «Файлы»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
