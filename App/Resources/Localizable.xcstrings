    "settings.reduceResourceUsageHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوقف العرض في الخلفية ويحرر الصور النقطية للصفحات عند التصغير أو عدم النشاط. تستمر ترجمة المستند بالكامل."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "وقّف الرسم في الخلفية وحرّر صور الصفحات لما التطبيق يتصغّر أو يبقى مش نشط. ترجمة المستند كله بتكمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট করা বা নিষ্ক্রিয় অবস্থায় পেছনের রেন্ডারিং থামিয়ে পৃষ্ঠার বিটম্যাপ ছেড়ে দেয়। সম্পূর্ণ নথির অনুবাদ চলতে থাকে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrunddarstellung pausieren und Seiten-Bitmaps bei minimiertem oder inaktivem Fenster freigeben. Die Übersetzung des gesamten Dokuments läuft weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause background rendering and release page bitmaps when minimized or inactive. Full-document translation continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar el renderizado y liberar imágenes en segundo plano. La traducción completa continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendre le rendu et libérer les images en arrière-plan. La traduction intégrale continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम या निष्क्रिय होने पर पृष्ठ चित्रों को छोड़कर पृष्ठभूमि रेंडरिंग रोकें। पूरे दस्तावेज़ का अनुवाद जारी रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小化・非アクティブ時に描画を停止し、ページ画像を解放します。全文翻訳は継続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소화하거나 비활성 상태일 때 렌더링을 멈추고 페이지 이미지를 해제합니다. 전체 문서 번역은 계속됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause background drawing and free page pictures when app small or no dey active. Full document translation still dey go on."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar a renderização em segundo plano e libertar mapas de bits das páginas quando minimizado ou inativo. A tradução do documento completo continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливать фоновую отрисовку и освобождать растровые изображения страниц, когда окно свёрнуто или неактивно. Перевод всего документа продолжается."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ونڈو چھوٹی یا غیر فعال ہونے پر پس منظر کی رینڈرنگ روک کر صفحے کی بٹ میپس آزاد کرتا ہے۔ مکمل دستاویز کا ترجمہ جاری رہتا ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口最小化或应用非前台时暂停绘制并释放页面位图；全文翻译继续执行。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗最小化或應用程式非前景時暫停繪製並釋放頁面點陣圖；全文翻譯繼續執行。"
          }
        }
      }
    },
