    "settings.emphasizeInformationHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضع خطوط سفلية خفيفة علامات على الكلمات المفتاحية لنتائج البحث والترتيب والاستدلال والاكتشاف والمقارنة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوط تحتية خفيفة بتعلّم كلمات نتائج البحث والترتيب والاستدلال والاكتشاف والمقارنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গবেষণার ফল, ক্রম, যুক্তি, আবিষ্কার ও তুলনার মূল শব্দের নিচে হালকা দাগ দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezente Unterstreichungen markieren Schlüsselwörter zu Forschungsergebnissen, Reihenfolge, Argumentation, Entdeckungen und Vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtle underlines mark research results, ordering, reasoning, discovery and comparison keywords."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subrayar suavemente palabras clave de resultados, orden, lógica, descubrimientos y comparaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souligner discrètement les mots clés des résultats, de l’ordre, du raisonnement, des découvertes et des comparaisons."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुसंधान परिणाम, क्रम, तर्क, खोज और तुलना के प्रमुख शब्दों के नीचे हल्की रेखाएँ लगाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "研究結果・順序・論理・発見・比較のキーワードに細い下線を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연구 결과, 순서, 논리, 발견 및 비교 관련 키워드에 가는 밑줄을 표시합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Small underlines mark research result, order, reasoning, discovery and comparison keywords."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublinhados subtis marcam palavras-chave de resultados de investigação, ordem, raciocínio, descobertas e comparações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкие подчёркивания отмечают ключевые слова, связанные с результатами исследований, порядком, рассуждениями, открытиями и сравнениями."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقیقی نتائج، ترتیب، استدلال، دریافت اور موازنے کے کلیدی الفاظ کے نیچے ہلکی لکیریں لگاتا ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用细下划线标示科研结果、序数、逻辑、发现和比较关键词。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "用細底線標示科研結果、序數、邏輯、發現與比較關鍵詞。"
          }
        }
      }
    },
