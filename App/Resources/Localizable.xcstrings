    "ios.translationFontFooter": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على النص المترجم القابل للتحديد في جميع محركات الترجمة. تحافظ المعادلات والنص الأصلي غير المتغير على مظهرهما الأصلي. لا يمكن إعادة تنسيق ملفات PDF التي تحتوي على صور فقط."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بينطبق على النص المترجم القابل للتحديد في كل محركات الترجمة. المعادلات والنص الأصلي اللي ما اتغيرش بيفضلوا بنفس شكلهم الأصلي. ملفات الـPDF اللي فيها صور بس ما ينفعش يتعاد تنسيقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব অনুবাদ ইঞ্জিনে নির্বাচনযোগ্য অনূদিত লেখায় প্রযোজ্য। সমীকরণ এবং অপরিবর্তিত মূল লেখা তাদের আসল চেহারা বজায় রাখে। শুধু ছবি থাকা PDF-এর স্টাইল বদলানো যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für auswählbaren übersetzten Text in allen Übersetzungs-Engines. Gleichungen und unveränderter Originaltext behalten ihr ursprüngliches Erscheinungsbild. PDFs, die nur Bilder enthalten, können nicht neu formatiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to selectable translated text in all engines. Equations and unchanged source text keep their original appearance. Image-only PDFs cannot be restyled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al texto traducido seleccionable en todos los motores. Las ecuaciones y el texto original sin cambios conservan su apariencia original. Los PDF que solo contienen imágenes no se pueden cambiar de estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique au texte traduit sélectionnable dans tous les moteurs. Les équations et le texte source inchangé conservent leur apparence d’origine. Les PDF composés uniquement d’images ne peuvent pas être restylés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी अनुवाद इंजनों में चयन योग्य अनुवादित टेक्स्ट पर लागू होता है। समीकरण और अपरिवर्तित मूल टेक्स्ट अपना मूल रूप बनाए रखते हैं। केवल इमेज वाले PDF की शैली नहीं बदली जा सकती।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての翻訳エンジンで選択可能な翻訳テキストに適用されます。数式と変更されていない原文テキストは元の外観を維持します。画像のみの PDF はスタイルを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 번역 엔진에서 선택할 수 있는 번역 텍스트에 적용됩니다. 수식과 변경되지 않은 원문 텍스트는 원래 모양을 유지합니다. 이미지만 포함된 PDF는 스타일을 변경할 수 없습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey affect translated text wey person fit select from all translation engines. Equations and source text wey no change keep their original look. You no fit restyle PDFs wey get images only."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao texto traduzido selecionável em todos os motores. As equações e o texto original que não foi alterado mantêm o seu aspeto original. Não é possível alterar o estilo de PDFs que contêm apenas imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к выделяемому переведённому тексту во всех движках. Уравнения и неизменённый исходный текст сохраняют исходный вид. PDF-файлы, состоящие только из изображений, нельзя стилизовать заново."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تمام ترجمہ انجنوں میں قابلِ انتخاب ترجمہ شدہ متن پر لاگو ہوتا ہے۔ مساوات اور غیر تبدیل شدہ اصل متن اپنی اصل شکل برقرار رکھتے ہیں۔ صرف تصاویر والی PDF فائلوں کا انداز تبدیل نہیں کیا جا سکتا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有翻译引擎中的可选中翻译文本。公式和未改变的原文保持原有外观。仅包含图片的 PDF 无法重新设置样式。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有翻譯引擎中的可選取翻譯文字。公式和未變更的原文維持原有外觀。僅包含圖片的 PDF 無法重新設定樣式。"
          }
        }
      }
    },
