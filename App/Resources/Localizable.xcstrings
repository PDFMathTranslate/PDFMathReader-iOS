          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimiser les espaces entre les paragraphes en mode lecture"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पठन मोड में अनुच्छेद अंतराल अनुकूलित करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
