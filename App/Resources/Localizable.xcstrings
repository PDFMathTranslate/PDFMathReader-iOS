    "advanced.options.primary_font_family.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز عائلة الخط الأساسية للنص المترجم؛ وإذا لم تُحدّد، فسيُختار الخط تلقائيًا من خصائص النص الأصلي."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر عيلة الخط الأساسية للنص المترجم؛ لو ماحددتش، هتتختار تلقائيًا من خصائص النص الأصلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনূদিত লেখার প্রধান ফন্ট পরিবার বদলান; নির্দিষ্ট না করলে মূল লেখার বৈশিষ্ট্য থেকে স্বয়ংক্রিয়ভাবে বেছে নেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die primäre Schriftfamilie für übersetzten Text überschreiben; ohne Angabe wird sie automatisch aus den Eigenschaften des Originaltexts gewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Override the primary font family for translated text; if unspecified, choose automatically from the original text properties."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribir la familia tipográfica principal del texto traducido; si no se especifica, se selecciona automáticamente según las propiedades del texto original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer la famille de polices principale du texte traduit ; si elle n’est pas définie, la sélectionner automatiquement selon les propriétés du texte original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनूदित पाठ के लिए प्राथमिक फ़ॉन्ट परिवार बदलें; निर्दिष्ट न होने पर मूल पाठ के गुणों से अपने आप चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳文の主フォントファミリーを上書きします。未指定の場合は原文の属性に基づいて自動選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 텍스트의 기본 글꼴 계열을 재정의합니다. 지정하지 않으면 원문 속성에 따라 자동으로 선택합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the main font family for translated text; if you no specify am, choose am from the original text properties."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir a família de tipos de letra principal do texto traduzido; se não for indicada, é escolhida automaticamente a partir das propriedades do texto original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределить основное семейство шрифтов для переведённого текста; если оно не задано, выбрать автоматически по свойствам исходного текста."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمہ شدہ متن کی بنیادی فونٹ فیملی تبدیل کریں؛ اگر مخصوص نہ ہو تو اصل متن کی خصوصیات سے خودکار طور پر منتخب کی جائے گی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖译文使用的主要字体族；未指定时，根据原文属性自动选择。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫譯文使用的主要字型系列；未指定時，會根據原文屬性自動選擇。"
          }
        }
      }
    },
