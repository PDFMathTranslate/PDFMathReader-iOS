    "ios.noRecentPDFsDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد PDF أو EPUB لبدء القراءة. ستتم استعادة موضعك وإعدادات العرض في المرة القادمة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد PDF أو EPUB عشان تبدأ القراءة. مكانك وإعدادات العرض هتترجع المرة الجاية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পড়া শুরু করতে একটি PDF বা EPUB আমদানি করুন। আপনার অবস্থান ও প্রদর্শন সেটিংস পরের বার ফিরিয়ে আনা হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie ein PDF oder EPUB, um mit dem Lesen zu beginnen. Ihre Position und Anzeigeeinstellungen werden beim nächsten Mal wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a PDF or EPUB to start reading. Your position and display settings will be restored next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un PDF o EPUB para empezar a leer. Tu posición y los ajustes de pantalla se restaurarán la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un PDF ou un EPUB pour commencer la lecture. Votre position et vos réglages d’affichage seront restaurés la prochaine fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ना शुरू करने के लिए PDF या EPUB आयात करें। आपका स्थान और प्रदर्शन सेटिंग अगली बार पुनर्स्थापित हो जाएँगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF または EPUB を読み込んで読み始めます。次回、位置と表示設定が復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 또는 EPUB를 가져와 읽기를 시작하세요. 다음에 위치와 화면 설정이 복원됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Import PDF or EPUB to start reading. Your position and display settings go restore next time."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe um PDF ou EPUB para começar a ler. A sua posição e as definições de apresentação serão restauradas da próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте PDF или EPUB, чтобы начать чтение. В следующий раз будут восстановлены ваша позиция и настройки отображения."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پڑھنا شروع کرنے کے لیے PDF یا EPUB درآمد کریں۔ آپ کی پوزیشن اور ڈسپلے کی ترتیبات اگلی بار بحال ہو جائیں گی۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 PDF 或 EPUB 以开始阅读。下次将恢复你的位置和显示设置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入 PDF 或 EPUB 以開始閱讀。下次會還原你的位置和顯示設定。"
          }
        }
      }
    },
