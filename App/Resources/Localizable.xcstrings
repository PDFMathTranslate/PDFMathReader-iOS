    "ios.computerAlreadyOpen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المستند مفتوح بالفعل على جهاز آخر. أغلقه هناك قبل فتحه هنا."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "المستند ده مفتوح على جهاز تاني. اقفله هناك قبل ما تفتحه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নথিটি ইতিমধ্যে অন্য একটি ডিভাইসে খোলা আছে। এখানে খোলার আগে সেখানে বন্ধ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist bereits auf einem anderen Gerät geöffnet. Schließen Sie es dort, bevor Sie es hier öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is already open on another device. Close it there before opening it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento ya está abierto en otro dispositivo. Ciérrelo allí antes de abrirlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document est déjà ouvert sur un autre appareil. Fermez-le sur cet appareil avant de l’ouvrir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दस्तावेज़ पहले से किसी अन्य डिवाइस पर खुला है। इसे यहाँ खोलने से पहले वहाँ बंद करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類はすでに別のデバイスで開いています。ここで開く前に、そちらで閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 다른 기기에서 이미 열려 있습니다. 여기서 열기 전에 다른 기기에서 닫으세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This document don already open for another device. Close am there before you open am here."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento já está aberto em outro dispositivo. Feche-o lá antes de abri-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот документ уже открыт на другом устройстве. Закройте его там, прежде чем открывать здесь."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دستاویز پہلے ہی کسی اور ڈیوائس پر کھلی ہے۔ یہاں کھولنے سے پہلے اسے وہاں بند کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档已在其他设备上打开。请先在其他设备上关闭，再在此处打开。"
