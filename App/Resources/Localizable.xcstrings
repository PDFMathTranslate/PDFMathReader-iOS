        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрабатывать чередующиеся номера строк и абзацы текста в документах с номерами строк."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سطر نمبرز والی دستاویزات میں باری باری آنے والے سطر نمبرز اور متنی پیراگراف سنبھالیں۔"
