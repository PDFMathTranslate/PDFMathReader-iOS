    "advanced.options.figure_table_protection_threshold.help": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حد حماية الأشكال والجداول؛ لا تُعالج الأسطر الموجودة داخلها."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "حد حماية الأشكال والجداول؛ السطور اللي جواها مش بتتـعالج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চিত্র ও টেবিলের সুরক্ষা সীমা; এগুলির ভেতরের লাইন প্রক্রিয়া করা হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schutzschwellenwert für Abbildungen und Tabellen; darin enthaltene Zeilen werden nicht verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection threshold for figures and tables; lines inside them are not processed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbral de protección para no procesar líneas dentro de figuras y tablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuil de protection empêchant le traitement des lignes dans les figures et les tableaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आकृतियों और तालिकाओं के लिए सुरक्षा सीमा; इनके भीतर की पंक्तियों पर प्रक्रिया नहीं होती।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図や表の内部の行を処理しないための保護しきい値。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이나 표 안의 줄을 처리하지 않도록 하는 보호 임계값입니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection limit for figures and tables; lines inside dem no dey process."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiar de proteção para figuras e tabelas; as linhas no seu interior não são processadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порог защиты рисунков и таблиц; строки внутри них не обрабатываются."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شکلوں اور ٹیبلز کے لیے تحفظ کی حد؛ ان کے اندر کی سطریں پراسیس نہیں ہوں گی۔"
          }
        },
