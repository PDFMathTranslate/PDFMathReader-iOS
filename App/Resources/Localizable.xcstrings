    "recentStatus.unknown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُسجّل حالة ترجمة بعد. افتح هذا المستند لتسجيل تقدّمه."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "لسه مفيش حالة ترجمة متسجلة. افتح المستند ده عشان نسجّل تقدّمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো অনুবাদের অবস্থা নথিভুক্ত হয়নি। অগ্রগতি নথিভুক্ত করতে এই নথি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Übersetzungsstatus aufgezeichnet. Öffnen Sie dieses Dokument, um den Fortschritt aufzuzeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No translation status recorded yet. Open this document to record its progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay un estado registrado. Abre el documento para registrar el progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun état enregistré. Ouvrez le document pour enregistrer sa progression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई अनुवाद स्थिति दर्ज नहीं है। प्रगति दर्ज करने के लिए यह दस्तावेज़ खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳状況はまだ記録されていません。文書を開くと進捗を記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 번역 상태가 기록되지 않았습니다. 문서를 열어 진행 상황을 기록하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We never record translation status. Open this document make we record the progress."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi registado nenhum estado de tradução. Abra este documento para registar o progresso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние перевода ещё не записано. Откройте этот документ, чтобы сохранить прогресс."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی ترجمے کی کوئی حالت درج نہیں۔ پیش رفت درج کرنے کے لیے یہ دستاویز کھولیں۔"
