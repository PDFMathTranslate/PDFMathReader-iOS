    "ios.computerSearchFailed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر البحث عن أجهزة الكمبيوتر القريبة، لكن سيستمر التحقق من أجهزة Tailscale المحفوظة. اسمح بالوصول إلى الشبكة المحلية في الإعدادات، أو أدخل عنوان الكمبيوتر يدويًا."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "مش قادرين نبحث عن الكمبيوترات القريبة، بس هنفضل نتحقق من كمبيوترات Tailscale المحفوظة. اسمح بالوصول للشبكة المحلية من الإعدادات، أو اكتب عنوان الكمبيوتر يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছাকাছি কম্পিউটার খোঁজা যায়নি, তবে মনে রাখা Tailscale কম্পিউটারগুলো পরীক্ষা করা হবে। সেটিংসে স্থানীয় নেটওয়ার্কে প্রবেশের অনুমতি দিন, অথবা কম্পিউটারের ঠিকানা নিজে লিখুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer in der Nähe konnten nicht gesucht werden, aber gemerkte Tailscale-Computer werden weiterhin geprüft. Erlauben Sie in den Einstellungen den Zugriff auf das lokale Netzwerk oder geben Sie die Computeradresse manuell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not search for nearby computers, but remembered Tailscale computers are still checked. Allow Local Network access in Settings, or enter the computer address manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido buscar ordenadores cercanos, pero se seguirán comprobando los ordenadores Tailscale recordados. Permite el acceso a la red local en Ajustes o introduce manualmente la dirección del ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rechercher les ordinateurs à proximité, mais les ordinateurs Tailscale mémorisés sont tout de même vérifiés. Autorisez l’accès au réseau local dans Réglages ou saisissez manuellement l’adresse de l’ordinateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नज़दीकी कंप्यूटर खोज नहीं सके, लेकिन याद रखे गए Tailscale कंप्यूटरों की जाँच जारी रहेगी। सेटिंग्स में स्थानीय नेटवर्क का ऐक्सेस दें या कंप्यूटर का पता मैन्युअल रूप से दर्ज करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのコンピュータを検索できませんでしたが、記憶された Tailscale コンピュータは引き続き確認します。「設定」でローカルネットワークへのアクセスを許可するか、コンピュータのアドレスを手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 컴퓨터를 검색할 수 없지만, 기억된 Tailscale 컴퓨터는 계속 확인합니다. 설정에서 로컬 네트워크 접근을 허용하거나 컴퓨터 주소를 직접 입력하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We no fit search nearby computers, but we go still check Tailscale computers wey you remember. Allow Local Network access in Settings, or enter the computer address by hand."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível pesquisar computadores próximos, mas os computadores Tailscale memorizados continuam a ser verificados. Permita o acesso à rede local em Definições ou introduza manualmente o endereço do computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти ближайшие компьютеры, но сохранённые компьютеры Tailscale всё равно будут проверены. Разрешите доступ к локальной сети в настройках или введите адрес компьютера вручную."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریب کے کمپیوٹرز تلاش نہیں ہو سکے، لیکن یاد رکھے گئے Tailscale کمپیوٹرز کو پھر بھی چیک کیا جائے گا۔ سیٹنگز میں مقامی نیٹ ورک تک رسائی کی اجازت دیں، یا کمپیوٹر کا پتہ دستی طور پر درج کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无法搜索附近的电脑，但仍会检查已记住的 Tailscale 电脑。请在“设置”中允许访问局域网，或手动输入电脑地址。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法搜尋附近的電腦，但仍會檢查已記住的 Tailscale 電腦。請在「設定」中允許取用區域網路，或手動輸入電腦位址。"
          }
        }
      }
    },
    "ios.computerSessionUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة مستند الكمبيوتر هذه غير متاحة. حدّث القائمة وحاول مرة أخرى."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة مستند الكمبيوتر ده مش متاحة. حدّث القائمة وجرب تاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কম্পিউটার নথির সেশনটি উপলভ্য নয়। তালিকা রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung für dieses Computerdokument ist nicht verfügbar. Aktualisieren Sie die Liste und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer document session is unavailable. Refresh the list and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de este documento del ordenador no está disponible. Actualice la lista e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de ce document informatique est indisponible. Actualisez la liste et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कंप्यूटर दस्तावेज़ का सत्र उपलब्ध नहीं है। सूची को रिफ्रेश करके फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータ書類のセッションは利用できません。リストを更新してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터 문서 세션을 사용할 수 없습니다. 목록을 새로 고친 후 다시 시도하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer document session no dey available. Refresh the list and try again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão deste documento do computador está indisponível. Atualize a lista e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс этого документа на компьютере недоступен. Обновите список и повторите попытку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کمپیوٹر دستاویز کا سیشن دستیاب نہیں۔ فہرست تازہ کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑文档会话不可用。请刷新列表后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此電腦文件工作階段無法使用。請重新整理列表後再試一次。"
          }
        }
      }
    },
