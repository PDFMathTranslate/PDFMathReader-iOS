    "ios.disclosureRemoteKernel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل «سريع» و«دقيق» صفحات PDF الفردية إلى حاسوبك أو إلى خادم النواة البعيدة الذي تدخله."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "«سريع» و«دقيق» بيبعتوا صفحات PDF لوحدها للكمبيوتر بتاعك أو لسيرفر النواة البعيدة اللي بتدخله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ও নির্ভুল মোড আলাদা PDF পৃষ্ঠা আপনার কম্পিউটারে বা আপনার দেওয়া দূরবর্তী কার্নেল সার্ভারে পাঠায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und Präzise senden einzelne PDF-Seiten an Ihren Computer oder an den von Ihnen angegebenen Remote-Kernel-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise send individual PDF pages to your computer or to the remote kernel server you enter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido y Preciso envían páginas PDF individuales a tu ordenador o al servidor del núcleo remoto que indiques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide et Précis envoient les pages PDF individuelles à votre ordinateur ou au serveur du noyau distant que vous indiquez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ और सटीक मोड अलग-अलग PDF पृष्ठ आपके कंप्यूटर या आपके द्वारा दर्ज रिमोट कर्नेल सर्वर पर भेजते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「高速」と「高精度」は、PDF の各ページをお使いのコンピュータまたは指定したリモートカーネルサーバーに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠름 및 정밀 모드는 개별 PDF 페이지를 컴퓨터 또는 입력한 원격 커널 서버로 보냅니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise dey send each PDF page go your computer or the remote kernel server wey you enter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e Preciso enviam páginas PDF individuais para o seu computador ou para o servidor de kernel remoto que indicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы «Быстрый» и «Точный» отправляют отдельные страницы PDF на ваш компьютер или на указанный вами сервер удалённого ядра."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیز اور درست موڈ الگ الگ PDF صفحات آپ کے کمپیوٹر یا آپ کے درج کردہ ریموٹ کرنل سرور پر بھیجتے ہیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“快速”和“精确”会将单个 PDF 页面发送到你的电脑或你输入的远程内核服务器。"
          }
