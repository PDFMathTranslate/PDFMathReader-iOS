        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 번호가 있는 문서에서 번갈아 나타나는 줄 번호와 텍스트 단락을 처리합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
