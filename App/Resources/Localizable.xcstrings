        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF is unavailable. It may have been moved or deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PDF no está disponible. Es posible que se haya movido o eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce PDF est indisponible. Il a peut-être été déplacé ou supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह PDF उपलब्ध नहीं है। शायद इसे कहीं और ले जाया गया है या हटा दिया गया है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
