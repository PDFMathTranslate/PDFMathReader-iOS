    "advanced.bundledKernel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النواة مضمّنة مع التطبيق؛ حدّث التطبيق لتحديثها."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "النواة دي جاية مع التطبيق؛ حدّث التطبيق عشان تحدّثها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কার্নেলটি অ্যাপের সঙ্গে আছে; আপডেট করতে অ্যাপটি আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kernel ist in der App enthalten; aktualisieren Sie die App, um ihn zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This kernel is bundled with the app; update the app to update it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este núcleo está incluido en la aplicación. Actualice la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce noyau est intégré à l’application. Mettez l’application à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कर्नेल ऐप के साथ शामिल है; इसे अपडेट करने के लिए ऐप अपडेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカーネルはアプリに同梱されています。アプリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 커널은 앱에 포함되어 있습니다. 앱을 업데이트하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This kernel come with app; update app to update am."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este kernel está incluído na aplicação; atualize a aplicação para o atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ядро входит в приложение; обновите приложение, чтобы обновить его."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کرنل ایپ کے ساتھ شامل ہے؛ اسے اپ ڈیٹ کرنے کے لیے ایپ اپ ڈیٹ کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此内核随应用提供，请更新应用以更新内核。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此核心隨應用程式提供，請更新應用程式。"
          }
        }
      }
    },
