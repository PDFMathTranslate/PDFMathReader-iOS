    "core.error.OpenAI rate limit reached. Reduce parallel requests and retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بلوغ حد معدل طلبات OpenAI. خفّض عدد الطلبات المتوازية وأعد المحاولة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت لحد طلبات OpenAI. قلّل الطلبات المتوازية وجرّب تاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-এর rate limit-এ পৌঁছে গেছে। parallel request কমিয়ে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das OpenAI-Ratenlimit wurde erreicht. Verringern Sie die Anzahl paralleler Anfragen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI rate limit reached. Reduce parallel requests and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de solicitudes de OpenAI. Reduce las solicitudes paralelas y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de requêtes OpenAI a été atteinte. Réduisez les requêtes parallèles et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI rate limit तक पहुँच गए हैं। parallel requests कम करके फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI のレート制限に達しました。並列リクエスト数を減らして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 요청 한도에 도달했습니다. 병렬 요청 수를 줄인 후 다시 시도하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI rate limit don reach. Reduce parallel requests and try again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de pedidos da OpenAI foi atingido. Reduza os pedidos paralelos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит запросов OpenAI. Уменьшите число параллельных запросов и повторите попытку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI کی شرحِ درخواست کی حد پہنچ گئی ہے۔ متوازی درخواستیں کم کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到 OpenAI 速率限制。请减少并行请求后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已達到 OpenAI 速率限制。請減少平行要求後重試。"
          }
        }
      }
    },
    "core.error.OpenAI rejected the configured API key. Update it in Settings or your launch environment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض OpenAI مفتاح API الذي تم تكوينه. حدّثه في الإعدادات أو في بيئة التشغيل."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI رفض مفتاح الـ API المتظبط. حدّثه في الإعدادات أو في بيئة التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI কনফিগার করা API key প্রত্যাখ্যান করেছে। Settings বা আপনার launch environment-এ এটি আপডেট করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI hat den konfigurierten API-Schlüssel abgelehnt. Aktualisieren Sie ihn in den Einstellungen oder in Ihrer Startumgebung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI rejected the configured API key. Update it in Settings or your launch environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI rechazó la clave de API configurada. Actualízala en Ajustes o en el entorno de lanzamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI a rejeté la clé API configurée. Mettez-la à jour dans Réglages ou dans votre environnement de lancement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI ने configured API key अस्वीकार कर दी। इसे Settings या अपने launch environment में अपडेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI が設定された API key を拒否しました。Settings または起動環境で更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI가 구성된 API key를 거부했습니다. Settings 또는 시작 환경에서 업데이트하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI reject the API key wey you set. Update am for Settings or your launch environment."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A OpenAI rejeitou a chave de API configurada. Atualize-a nas Definições ou no ambiente de lançamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI отклонила настроенный ключ API. Обновите его в настройках или в среде запуска."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI نے ترتیب دی گئی API کلید مسترد کر دی۔ اسے ترتیبات یا اپنے لانچ ماحول میں اپ ڈیٹ کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 拒绝了已配置的 API key。请在设置或启动环境中更新它。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 拒絕了已設定的 API key。請在設定或啟動環境中更新它。"
          }
        }
      }
    },
