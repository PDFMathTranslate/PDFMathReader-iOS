    "ios.translationFontFooter": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق فقط على طبقات النص المترجم؛ يظل تخطيط الصفحة الأصلية دون تغيير. لا يمكن إعادة تنسيق ملفات PDF المترجمة عن بُعد."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بينطبق بس على طبقات النص المترجم؛ تخطيط الصفحة الأصلية ما بيتغيرش. ملفات PDF المترجمة عن بُعد ما ينفعش يتعاد تنسيقها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অনূদিত টেক্সট ওভারলেতে প্রযোজ্য; মূল পৃষ্ঠার বিন্যাস অপরিবর্তিত থাকে। দূরবর্তী অনূদিত PDF-এর স্টাইল বদলানো যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Übersetzungstext-Overlays; das Layout der Originalseite bleibt unverändert. Übersetzte PDFs aus der Ferne können nicht neu formatiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to translated text overlays; the original page layout is unchanged. Remote translated PDFs cannot be restyled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica a las superposiciones de texto traducido; el diseño de la página original no cambia. Los PDF traducidos de forma remota no se pueden volver a diseñar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique uniquement aux superpositions de texte traduit ; la mise en page de la page d’origine reste inchangée. Les PDF traduits à distance ne peuvent pas être restylés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अनुवादित टेक्स्ट ओवरले पर लागू होता है; मूल पृष्ठ का लेआउट अपरिवर्तित रहता है। दूरस्थ रूप से अनुवादित PDF की शैली बदली नहीं जा सकती।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳テキストのオーバーレイにのみ適用され、元のページレイアウトは変わりません。リモートで翻訳された PDF のスタイルは変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역된 텍스트 오버레이에만 적용되며 원본 페이지 레이아웃은 변경되지 않습니다. 원격으로 번역된 PDF는 스타일을 다시 지정할 수 없습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey affect translated text overlays only; the original page layout no change. You no fit restyle remote translated PDFs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se apenas às sobreposições de texto traduzido; o esquema da página original não é alterado. Não é possível alterar o estilo de PDFs traduzidos remotamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется только к наложениям переведённого текста; макет исходной страницы не изменяется. Стиль удалённо переведённых PDF нельзя изменить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف ترجمہ شدہ متن کی اوورلے پر لاگو ہوتا ہے؛ اصل صفحے کی ترتیب تبدیل نہیں ہوتی۔ دور سے ترجمہ شدہ PDF کو دوبارہ اسٹائل نہیں کیا جا سکتا۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅应用于翻译文本覆盖层；原始页面布局保持不变。远程翻译的 PDF 无法重新设置样式。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅套用於翻譯文字覆蓋層；原始頁面版面維持不變。遠端翻譯的 PDF 無法重新設定樣式。"
          }
        }
      }
    },
