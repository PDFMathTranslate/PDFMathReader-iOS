    "settings.customLanguageCodeReminder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق بعناية من رمزي اللغة المصدر والهدف المخصّصين. تأكّد من أن النواة وخدمة الترجمة المحددتين تدعمانهما؛ فقد تؤدي الرموز الخاطئة أو غير المدعومة إلى فشل الترجمة أو نتائج غير صحيحة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع أكواد لغة المصدر واللغة اللي هتترجم ليها كويس. واتأكد إن النواة وخدمة الترجمة اللي اخترتهم بيدعموها؛ الأكواد الغلط أو اللي مش مدعومة ممكن تفشل الترجمة أو تطلع نتيجة غلط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাস্টম উৎস ও লক্ষ্য ভাষার কোড ভালো করে পরীক্ষা করুন। নির্বাচিত কার্নেল ও অনুবাদ পরিষেবা সেগুলি সমর্থন করে কি না নিশ্চিত করুন; ভুল বা অসমর্থিত কোড অনুবাদ ব্যর্থ করতে পারে বা ভুল ফল দিতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie benutzerdefinierte Quell- und Zielsprachencodes sorgfältig. Vergewissern Sie sich, dass der ausgewählte Kernel und Übersetzungsdienst sie unterstützen; falsche oder nicht unterstützte Codes können zu Übersetzungsfehlern oder falschen Ergebnissen führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check custom source and target codes carefully. Confirm that your selected kernel and translation service support them; incorrect or unsupported codes may cause translation failures or incorrect results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise cuidadosamente los códigos de origen y destino y confirme que el motor y el servicio elegidos los admiten. Los códigos incorrectos o incompatibles pueden causar errores de traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez soigneusement les codes source et cible et leur prise en charge par le moteur et le service choisis. Des codes incorrects ou non pris en charge peuvent produire des erreurs de traduction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम स्रोत और लक्ष्य कोड ध्यान से जाँचें। पुष्टि करें कि चुना हुआ कर्नेल और अनुवाद सेवा उनका समर्थन करते हैं; गलत या असमर्थित कोड अनुवाद विफल कर सकते हैं या गलत परिणाम दे सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原言語と翻訳先のカスタムコードを慎重に確認し、選択したカーネルと翻訳サービスが対応していることを確認してください。誤ったコードや未対応のコードは翻訳の失敗や誤った結果につながる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 및 대상 언어 코드를 신중히 확인하고 선택한 커널과 번역 서비스가 지원하는지 확인하세요. 잘못되거나 지원되지 않는 코드는 번역 실패 또는 잘못된 결과를 초래할 수 있습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the custom source and target codes well. Make sure the kernel and translation service you choose support dem; wrong or unsupported codes fit make translation fail or give wrong result."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique cuidadosamente os códigos de origem e destino personalizados. Confirme que o kernel e o serviço de tradução selecionados os suportam; códigos incorretos ou não suportados podem causar falhas de tradução ou resultados incorretos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимательно проверьте пользовательские коды исходного и целевого языков. Убедитесь, что выбранное ядро и сервис перевода их поддерживают: неверные или неподдерживаемые коды могут привести к ошибкам перевода или неправильным результатам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مخصوص ماخذ اور ہدف زبان کے کوڈ احتیاط سے چیک کریں۔ یقین کریں کہ منتخب کرنل اور ترجمہ سروس انہیں سپورٹ کرتے ہیں؛ غلط یا غیر معاون کوڈ ترجمے کی ناکامی یا غلط نتائج کا سبب بن سکتے ہیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请仔细核对自定义源语言和目标语言代码，并确认所选内核及翻译服务支持这些代码；错误或不支持的代码可能导致翻译失败或结果不正确。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請仔細核對自訂來源和目標語言代碼，並確認所選核心及翻譯服務支援；錯誤或不支援的代碼可能導致翻譯失敗或結果不正確。"
          }
        }
      }
    },
