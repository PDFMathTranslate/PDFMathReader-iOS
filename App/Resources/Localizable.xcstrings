        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte des paragraphes de votre PDF est envoyé au serveur compatible avec OpenAI que vous configurez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके PDF का पैराग्राफ़ टेक्स्ट आपके कॉन्फ़िगर किए गए OpenAI-संगत सर्वर को भेजा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
