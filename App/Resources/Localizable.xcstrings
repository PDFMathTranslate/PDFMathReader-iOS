        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer les numéros de ligne alternés et les paragraphes de texte des documents qui en contiennent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति संख्याओं वाले दस्तावेज़ों में बारी-बारी की पंक्ति संख्याओं और पाठ अनुच्छेदों को संभालें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行番号を含む文書で、交互に現れる行番号とテキスト段落を処理します。"
