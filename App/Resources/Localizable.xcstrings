    "translation.readingAhead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقليل طلبات الترجمة وترجمة صفحات أبعد أثناء التصفح"
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "قلّل طلبات الترجمة وترجم لقدّام أكتر وإنت بتتصفّح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুবাদের অনুরোধ কমিয়ে ব্রাউজ করার সময় আরও আগে অনুবাদ করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzungsanfragen reduzieren und beim Durchsuchen weiter voraus übersetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce translation requests, translate further ahead while browsing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir solicitudes y traducir más por adelantado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire les requêtes et traduire davantage en avance"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद अनुरोध घटाएँ और ब्राउज़ करते समय आगे के पृष्ठों का अनुवाद करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳リクエストを減らし、閲覧中にさらに先まで翻訳"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 요청을 줄이고 탐색 중 더 많이 미리 번역"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Make translation request less, translate more ahead as you browse"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir pedidos de tradução e traduzir mais à frente durante a navegação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сократить число запросов и переводить дальше при просмотре"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترجمے کی درخواستیں کم کریں، براؤز کرتے ہوئے مزید آگے ترجمہ کریں"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "降低翻译请求，但在浏览时提前翻译更多"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "減少翻譯請求，但在瀏覽時提前翻譯更多"
          }
        }
      }
    },
    "translation.readingAheadDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعطاء الأولوية للصفحات الظاهرة، وترجمة ما يصل إلى ست صفحات مسبقًا في اتجاه القراءة وصفحتين خلفها، مع إبقاء نطاق الترجمة محدودًا."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "بيقدّم الصفحات الظاهرة، ويترجم لحد ست صفحات لقدّام في اتجاه القراية وصفحتين ورا، مع الحفاظ على نطاق ترجمة محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৃশ্যমান পৃষ্ঠাকে অগ্রাধিকার দেয়, পড়ার দিকে সর্বোচ্চ ছয়টি পৃষ্ঠা আগে অনুবাদ করে এবং পেছনে দুটি পৃষ্ঠা রাখে, অনুবাদের পরিসর সীমিত রেখেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Seiten priorisieren, bis zu sechs Seiten in Leserichtung und zwei Seiten dahinter vorübersetzen und dabei den Übersetzungsumfang begrenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizes visible pages, pretranslates up to six pages in your reading direction and two pages behind, while keeping the translation scope limited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prioridad a las páginas visibles, pretraduce hasta seis páginas en la dirección de lectura y dos páginas hacia atrás, manteniendo un alcance limitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorise les pages visibles, prétraduit jusqu’à six pages dans le sens de lecture et deux pages en arrière, tout en gardant une portée limitée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिख रहे पृष्ठों को प्राथमिकता देता है, पढ़ने की दिशा में छह पृष्ठों तक पहले से अनुवाद करता है और पीछे दो पृष्ठ रखता है, जबकि अनुवाद का दायरा सीमित रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のページを優先し、読む方向に最大6ページ、後方に2ページを先行翻訳しながら、翻訳範囲を限定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 페이지를 우선하고 읽는 방향으로 최대 6페이지, 뒤쪽으로 2페이지를 미리 번역하면서 범위는 제한합니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E put visible pages first, translate up to six pages ahead for where you dey read and two pages behind, while e keep translation area small."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá prioridade às páginas visíveis, pré-traduz até seis páginas na direção de leitura e duas páginas atrás, mantendo limitado o âmbito da tradução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдавать приоритет видимым страницам, заранее переводить до шести страниц по направлению чтения и две страницы позади, ограничивая область перевода."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نظر آنے والے صفحات کو ترجیح دیتا ہے، مطالعے کی سمت میں چھ صفحات تک اور پیچھے دو صفحات کا پیشگی ترجمہ کرتا ہے، جبکہ ترجمے کا دائرہ محدود رکھتا ہے۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "优先翻译可见页面，沿阅读方向提前翻译最多六页，并在后方保留两页，同时保持有限的翻译范围。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "優先翻譯目前可見頁面，沿閱讀方向提前翻譯最多六頁，並在後方保留兩頁，同時維持有限的翻譯範圍。"
          }
        }
      }
    },
