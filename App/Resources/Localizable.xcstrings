    "ios.remoteKernelDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترجم «دقيق» الصفحات باستخدام خادم متوافق مع zotero-pdf2zh عند نجاح فحص سلامته، وإلا فباستخدام حاسوبك أو «فائق السرعة». يستخدم الخادم خدمة الترجمة وبيانات الاعتماد الخاصة به؛ ولا يُرسَل أي مفتاح API. تُرفع الصفحات كملفات PDF من صفحة واحدة ولا تحتوي على طبقة نص للقراءة. لا تُستخدم خدمة الترجمة المحددة ولا المسارد للصفحات المترجمة عن بُعد."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "«دقيق» بيترجم الصفحات بسيرفر متوافق مع zotero-pdf2zh لو فحص السلامة نجح، وإلا بيستخدم الكمبيوتر بتاعك أو «سريع جدًا». السيرفر بيستخدم خدمة الترجمة وبيانات الدخول بتاعته؛ ومفيش أي مفتاح API بيتبعت. الصفحات بتترفع كملفات PDF من صفحة واحدة ومن غير طبقة نص للقراءة. خدمة الترجمة المختارة والمسارد مش بتتستخدم للصفحات اللي بتتترجم عن بُعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাস্থ্য পরীক্ষা সফল হলে নির্ভুল মোড zotero-pdf2zh সামঞ্জস্যপূর্ণ সার্ভার দিয়ে পৃষ্ঠা অনুবাদ করে; অন্যথায় আপনার কম্পিউটার বা অতি দ্রুত মোড ব্যবহার করে। সার্ভার নিজের অনুবাদ পরিষেবা ও ক্রেডেনশিয়াল ব্যবহার করে; কোনো API কী পাঠানো হয় না। পৃষ্ঠাগুলি এক-পৃষ্ঠার PDF হিসেবে আপলোড হয় এবং এতে পড়ার টেক্সট স্তর থাকে না। দূরবর্তীভাবে অনূদিত পৃষ্ঠায় নির্বাচিত অনুবাদ পরিষেবা ও শব্দকোষ ব্যবহৃত হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präzise übersetzt Seiten mit einem zotero-pdf2zh-kompatiblen Server, wenn dessen Statusprüfung erfolgreich ist, andernfalls mit Ihrem Computer oder Extrem schnell. Der Server verwendet seinen eigenen Übersetzungsdienst und seine eigenen Zugangsdaten; es wird kein API-Schlüssel gesendet. Seiten werden als einseitige PDFs hochgeladen und haben keine Leseebene mit Text. Der ausgewählte Übersetzungsdienst und Glossare werden für remote übersetzte Seiten nicht verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise translates pages with a zotero-pdf2zh compatible server when its health check passes, and otherwise with your computer or Ultra fast. The server uses its own translation service and credentials; no API key is sent. Pages are uploaded as one-page PDFs and have no reading text layer. The selected translation service and glossaries are not used for remotely translated pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso traduce las páginas con un servidor compatible con zotero-pdf2zh cuando supera la comprobación de estado y, si no, con tu ordenador o con Ultrarrápido. El servidor usa su propio servicio de traducción y sus credenciales; no se envía ninguna clave de API. Las páginas se suben como PDF de una página y no tienen capa de texto de lectura. El servicio de traducción seleccionado y los glosarios no se usan en las páginas traducidas de forma remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis traduit les pages avec un serveur compatible zotero-pdf2zh lorsque sa vérification d’état réussit, sinon avec votre ordinateur ou Ultra-rapide. Le serveur utilise son propre service de traduction et ses propres identifiants ; aucune clé API n’est envoyée. Les pages sont envoyées sous forme de PDF d’une page et n’ont pas de couche de texte de lecture. Le service de traduction sélectionné et les glossaires ne sont pas utilisés pour les pages traduites à distance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वास्थ्य जाँच सफल होने पर सटीक मोड zotero-pdf2zh संगत सर्वर से पृष्ठों का अनुवाद करता है; अन्यथा आपके कंप्यूटर या अति-तेज़ मोड का उपयोग करता है। सर्वर अपनी अनुवाद सेवा और क्रेडेंशियल का उपयोग करता है; कोई API कुंजी नहीं भेजी जाती। पृष्ठ एक-पृष्ठ PDF के रूप में अपलोड होते हैं और उनमें पढ़ने के लिए टेक्स्ट परत नहीं होती। दूरस्थ रूप से अनुवादित पृष्ठों के लिए चुनी गई अनुवाद सेवा और शब्दावलियाँ उपयोग नहीं होतीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「高精度」は、ヘルスチェックに成功した場合は zotero-pdf2zh 互換サーバーでページを翻訳し、それ以外の場合はお使いのコンピュータまたは「超高速」を使用します。サーバーは独自の翻訳サービスと認証情報を使用し、API キーは送信されません。ページは 1 ページの PDF としてアップロードされ、読書用テキストレイヤーはありません。リモートで翻訳されたページには、選択した翻訳サービスと用語集は使用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정밀 모드는 상태 확인에 성공하면 zotero-pdf2zh 호환 서버로 페이지를 번역하고, 그렇지 않으면 컴퓨터 또는 매우 빠름을 사용합니다. 서버는 자체 번역 서비스와 자격 증명을 사용하며 API 키는 전송되지 않습니다. 페이지는 한 페이지짜리 PDF로 업로드되며 읽기용 텍스트 레이어가 없습니다. 원격으로 번역된 페이지에는 선택한 번역 서비스와 용어집이 사용되지 않습니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise dey translate pages with zotero-pdf2zh compatible server when e health check pass; if e no pass, e go use your computer or Ultra fast. The server dey use im own translation service and credentials; dem no dey send any API key. Pages dey upload as one-page PDF and dem no get reading text layer. The translation service wey you choose and glossaries no dey work for pages wey remote server translate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preciso traduz as páginas com um servidor compatível com zotero-pdf2zh quando a verificação de estado é bem-sucedida e, caso contrário, com o seu computador ou com Ultrarrápido. O servidor utiliza o seu próprio serviço de tradução e credenciais; nenhuma chave API é enviada. As páginas são carregadas como PDF de uma página e não têm camada de texto de leitura. O serviço de tradução selecionado e os glossários não são utilizados nas páginas traduzidas remotamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Точный» переводит страницы на сервере, совместимом с zotero-pdf2zh, если проверка состояния прошла успешно, а иначе — на вашем компьютере или в режиме «Сверхбыстрый». Сервер использует собственный сервис перевода и учётные данные; ключ API не отправляется. Страницы загружаются как одностраничные PDF и не содержат текстового слоя для чтения. Выбранный сервис перевода и глоссарии не используются для страниц, переведённых удалённо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صحت کی جانچ کامیاب ہونے پر درست موڈ zotero-pdf2zh سے مطابقت رکھنے والے سرور سے صفحات کا ترجمہ کرتا ہے؛ ورنہ آپ کا کمپیوٹر یا انتہائی تیز موڈ استعمال ہوتا ہے۔ سرور اپنی ترجمہ سروس اور اسناد استعمال کرتا ہے؛ کوئی API کلید نہیں بھیجی جاتی۔ صفحات ایک صفحے کی PDF کے طور پر اپ لوڈ ہوتے ہیں اور ان میں پڑھنے کی متنی تہہ نہیں ہوتی۔ دور سے ترجمہ شدہ صفحات کے لیے منتخب ترجمہ سروس اور فرہنگیں استعمال نہیں ہوتیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "健康检查通过时，“精确”通过 HTTP 使用兼容 zotero-pdf2zh 的服务器翻译页面，否则使用你的电脑或“超快”。服务器使用自己的翻译服务和凭据，不会发送任何 API 密钥。页面以单页 PDF 上传，没有阅读文本层。所选翻译服务和术语表不会用于远程翻译的页面。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "健康檢查通過時，「精確」會透過 HTTP 使用相容 zotero-pdf2zh 的伺服器翻譯頁面，否則使用你的電腦或「超快」。伺服器使用自己的翻譯服務與憑證，不會傳送任何 API 金鑰。頁面以單頁 PDF 上傳，沒有閱讀文字層。所選翻譯服務與詞彙表不會用於遠端翻譯的頁面。"
          }
        }
      }
    },
