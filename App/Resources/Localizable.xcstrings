    "ios.computerKernelDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل «سريع» و«دقيق» على حاسوبك ويعودان إلى «فائق السرعة». فعّل Auto-discovery في Experimental Features ومشاركة النوى على حاسوبك. اعثر على أجهزة الكمبيوتر القريبة أو أدخل عنوان Tailscale IP/MagicDNS مرة واحدة، ثم أدخل رمز الإقران وتحقق من الاتصال. يمكن العثور على أجهزة الكمبيوتر المحفوظة لاحقًا عبر Tailscale عند اتصال الجهازين. تُرسل الصفحات كملفات PDF من صفحة واحدة من دون طبقة نص للقراءة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "«سريع» و«دقيق» بيشتغلوا على الكمبيوتر بتاعك وبيتحولوا لـ«سريع جدًا». فعّل Auto-discovery من Experimental Features ومشاركة النوى على الكمبيوتر بتاعك. دوّر على كمبيوترات قريبة أو اكتب عنوان Tailscale IP/MagicDNS مرة واحدة، وبعد كده اكتب كود الاقتران واتأكد من الاتصال. تقدر تلاقي الكمبيوترات المحفوظة بعد كده عن طريق Tailscale لما الجهازين يكونوا متصلين. الصفحات بتتبعت كملفات PDF من صفحة واحدة ومن غير طبقة نص للقراءة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত ও নির্ভুল মোড আপনার কম্পিউটারে চলে এবং অতি দ্রুত মোডে ফিরে যায়। কম্পিউটারে Experimental Features থেকে Auto-discovery এবং kernel sharing চালু করুন। কাছাকাছি কম্পিউটার খুঁজুন অথবা একবার Tailscale IP/MagicDNS নাম লিখুন, তারপর পেয়ারিং কোড দিয়ে সংযোগ পরীক্ষা করুন। দুটি ডিভাইস সংযুক্ত থাকলে পরে Tailscale-এর মাধ্যমে মনে রাখা কম্পিউটারগুলো খুঁজে পাওয়া যাবে। পৃষ্ঠাগুলি পড়ার টেক্সট স্তর ছাড়াই এক-পৃষ্ঠার PDF হিসেবে পাঠানো হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell und Präzise laufen auf Ihrem Computer und fallen auf Extrem schnell zurück. Aktivieren Sie auf dem Computer Auto-discovery unter Experimental Features und die Kernel-Freigabe. Suchen Sie nach Computern in der Nähe oder geben Sie einmalig eine Tailscale-IP/MagicDNS-Adresse ein, geben Sie den Kopplungscode ein und prüfen Sie die Verbindung. Gemerkte Computer können später über Tailscale gefunden werden, wenn beide Geräte verbunden sind. Seiten werden als einseitige PDFs ohne Leseebene mit Text gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise run on your computer and fall back to Ultra fast. Enable Auto-discovery in Experimental Features and kernel sharing on your computer. Find nearby computers or enter a Tailscale IP/MagicDNS name once, enter the pairing code, and check the connection. Remembered computers can be found later over Tailscale when both devices are connected. Pages are sent as one-page PDFs without a reading text layer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido y Preciso se ejecutan en tu ordenador y recurren a Ultrarrápido. Activa Auto-discovery en Experimental Features y el uso compartido de kernels en el ordenador. Busca ordenadores cercanos o introduce una IP de Tailscale o un nombre de MagicDNS una vez, introduce el código de vinculación y comprueba la conexión. Los ordenadores recordados se pueden encontrar más adelante mediante Tailscale cuando ambos dispositivos estén conectados. Las páginas se envían como PDF de una página sin capa de texto de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide et Précis s’exécutent sur votre ordinateur et passent à Ultra-rapide. Activez Auto-discovery dans Experimental Features et le partage des noyaux sur votre ordinateur. Recherchez des ordinateurs à proximité ou saisissez une adresse IP Tailscale ou un nom MagicDNS une seule fois, saisissez le code de jumelage et vérifiez la connexion. Les ordinateurs mémorisés pourront ensuite être trouvés via Tailscale lorsque les deux appareils seront connectés. Les pages sont envoyées sous forme de PDF d’une page, sans couche de texte de lecture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ और सटीक मोड आपके कंप्यूटर पर चलते हैं और अति-तेज़ मोड पर लौटते हैं। कंप्यूटर पर Experimental Features में Auto-discovery और kernel sharing चालू करें। नज़दीकी कंप्यूटर खोजें या एक बार Tailscale IP/MagicDNS नाम दर्ज करें, फिर पेयरिंग कोड दर्ज करके कनेक्शन जाँचें। दोनों डिवाइस कनेक्ट होने पर याद रखे गए कंप्यूटर बाद में Tailscale के ज़रिए मिल सकते हैं। पृष्ठ बिना पढ़ने वाली टेक्स्ट परत के एक-पृष्ठ PDF के रूप में भेजे जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「高速」と「高精度」はコンピュータ上で実行され、利用できない場合は「超高速」にフォールバックします。コンピュータで Experimental Features の Auto-discovery とカーネル共有を有効にしてください。近くのコンピュータを検索するか、Tailscale IP/MagicDNS 名を一度入力し、ペアリングコードを入力して接続を確認します。両方のデバイスが接続されていれば、記憶されたコンピュータは後で Tailscale 経由で検索できます。ページは読書用テキストレイヤーなしの 1 ページ PDF として送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠름 및 정밀 모드는 컴퓨터에서 실행되며 사용할 수 없으면 매우 빠름으로 전환됩니다. 컴퓨터의 Experimental Features에서 Auto-discovery와 커널 공유를 켜세요. 주변 컴퓨터를 찾거나 Tailscale IP/MagicDNS 이름을 한 번 입력한 다음 페어링 코드를 입력하고 연결을 확인하세요. 두 기기가 연결되어 있으면 기억된 컴퓨터를 나중에 Tailscale을 통해 찾을 수 있습니다. 페이지는 읽기용 텍스트 레이어 없이 한 페이지짜리 PDF로 전송됩니다."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast and Precise dey run for your computer and go fall back to Ultra fast. Turn on Auto-discovery in Experimental Features and kernel sharing for your computer. Find computers wey dey near or enter Tailscale IP/MagicDNS name one time, enter di pairing code, and check di connection. You fit find computers wey you remember later through Tailscale when both devices dey connected. Pages dey go as one-page PDF without reading text layer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido e Preciso são executados no seu computador e recorrem a Ultrarrápido. Ative Auto-discovery em Experimental Features e a partilha de kernels no seu computador. Procure computadores próximos ou introduza uma vez um IP Tailscale ou nome MagicDNS, introduza o código de emparelhamento e verifique a ligação. Os computadores memorizados podem ser encontrados mais tarde através da Tailscale quando os dois dispositivos estiverem ligados. As páginas são enviadas como PDF de uma página sem camada de texto de leitura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы «Быстрый» и «Точный» работают на вашем компьютере и переключаются на «Сверхбыстрый». Включите Auto-discovery и общий доступ к ядрам на компьютере. Найдите ближайшие компьютеры или один раз введите IP-адрес Tailscale/имя MagicDNS, затем введите код сопряжения и проверьте подключение. Сохранённые компьютеры можно будет найти позже через Tailscale, когда оба устройства подключены. Страницы отправляются как одностраничные PDF без текстового слоя для чтения."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیز اور درست موڈ آپ کے کمپیوٹر پر چلتے ہیں اور انتہائی تیز موڈ پر واپس آتے ہیں۔ کمپیوٹر پر Auto-discovery اور kernel sharing کو فعال کریں۔ قریب کے کمپیوٹرز تلاش کریں یا ایک بار Tailscale IP/MagicDNS نام درج کریں، پھر پیئرنگ کوڈ درج کر کے کنکشن چیک کریں۔ جب دونوں ڈیوائسز منسلک ہوں تو یاد رکھے گئے کمپیوٹرز بعد میں Tailscale کے ذریعے تلاش کیے جا سکتے ہیں۔ صفحات پڑھنے کی متنی تہہ کے بغیر ایک صفحے کی PDF کے طور پر بھیجے جاتے ہیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“快速”和“精确”在电脑上运行，并在不可用时回退到“超快”。在电脑上启用 Auto-discovery 和内核共享。查找附近的电脑，或一次输入 Tailscale IP/MagicDNS 名称，然后输入配对码并检查连接。两台设备连接后，之后可以通过 Tailscale 找到已记住的电脑。页面以不含阅读文本层的单页 PDF 发送。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「快速」和「精確」會在電腦上執行，無法使用時會改用「超快」。在電腦上啟用 Auto-discovery 和核心分享。尋找附近的電腦，或輸入一次 Tailscale IP/MagicDNS 名稱，然後輸入配對碼並檢查連線。兩部裝置連線後，之後可透過 Tailscale 找到已記住的電腦。頁面會以不含閱讀文字層的單頁 PDF 傳送。"
          }
        }
      }
    },
    "ios.computerReleasePending": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار تأكيد الكمبيوتر حفظ المستند. أعد المحاولة لإتمام إغلاق هذا المستند."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "مستنيين الكمبيوتر يأكد الحفظ. جرّب تاني عشان تكمّل قفل المستند ده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কম্পিউটার সংরক্ষণ নিশ্চিত করার অপেক্ষায়। এই নথি বন্ধ করা শেষ করতে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf die Bestätigung des Computers, dass die Datei gespeichert wurde. Versuchen Sie es erneut, um das Schließen dieses Dokuments abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your computer to confirm the save. Retry to finish closing this document."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que su computadora confirme el guardado. Vuelva a intentarlo para terminar de cerrar este documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la confirmation de votre ordinateur. Réessayez pour terminer la fermeture de ce document."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्यूटर द्वारा सेव की पुष्टि की प्रतीक्षा है। इस दस्तावेज़ को बंद करना पूरा करने के लिए फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータによる保存の確認を待っています。書類を閉じるには、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터가 저장을 확인하기를 기다리는 중입니다. 이 문서 닫기를 완료하려면 다시 시도하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We dey wait for your computer to confirm the save. Try again to finish closing this document."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o computador confirmar o salvamento. Tente novamente para concluir o fechamento deste documento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание подтверждения сохранения от компьютера. Повторите попытку, чтобы завершить закрытие этого документа."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمپیوٹر کی جانب سے محفوظ ہونے کی تصدیق کا انتظار ہے۔ اس دستاویز کو بند کرنے کے لیے دوبارہ کوشش کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待电脑确认保存。请重试以完成关闭此文档。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待電腦確認儲存。請重試以完成關閉此文件。"
          }
        }
      }
    },
