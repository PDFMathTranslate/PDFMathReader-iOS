    "ios.appleTranslationModelsMissing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل لغات Apple Translation لـ %1$@ و%2$@. افتح الإعدادات، واختر الترجمة على الجهاز من Apple، ثم اضغط تنزيل اللغات وأعد المحاولة."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "لغات Apple Translation لـ %1$@ و%2$@ مش متنزلة. افتح الإعدادات، اختار ترجمة Apple على الجهاز، ودوس تنزيل اللغات وجرّب تاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ও %2$@-এর জন্য Apple Translation ভাষা ডাউনলোড করা হয়নি। সেটিংস খুলুন, Apple অন-ডিভাইস অনুবাদ বেছে নিন, ভাষা ডাউনলোড করুন ট্যাপ করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Translation-Sprachen für %1$@ und %2$@ sind nicht geladen. Öffne die Einstellungen, wähle Apple-Übersetzung auf dem Gerät und tippe auf „Sprachen laden“. Versuche es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation languages for %1$@ and %2$@ are not downloaded. Open Settings, choose Apple on-device translation, and tap Download Languages, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los idiomas de Apple Translation para %1$@ y %2$@ no están descargados. Abre Ajustes, elige la traducción en el dispositivo de Apple, toca Descargar idiomas y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les langues Apple Translation pour %1$@ et %2$@ ne sont pas téléchargées. Ouvrez Réglages, choisissez la traduction Apple sur l’appareil, touchez Télécharger les langues, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ और %2$@ के लिए Apple Translation भाषाएँ डाउनलोड नहीं हैं। सेटिंग्स खोलें, Apple ऑन-डिवाइस अनुवाद चुनें, भाषाएँ डाउनलोड करें पर टैप करें, फिर दोबारा कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ と %2$@ の Apple Translation 言語がダウンロードされていません。設定を開き、Apple のデバイス上翻訳を選んで「言語をダウンロード」をタップしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 및 %2$@용 Apple Translation 언어가 다운로드되지 않았습니다. 설정을 열고 Apple 온디바이스 번역을 선택한 다음 언어 다운로드를 탭하고 다시 시도하세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation languages for %1$@ and %2$@ never download. Open Settings, choose Apple on-device translation, tap Download Languages, then try again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os idiomas do Apple Translation para %1$@ e %2$@ não foram descarregados. Abra Definições, escolha a tradução no dispositivo da Apple, toque em Descarregar idiomas e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языки Apple Translation для %1$@ и %2$@ не загружены. Откройте настройки, выберите перевод Apple на устройстве, нажмите «Загрузить языки» и повторите попытку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ اور %2$@ کے لیے Apple Translation زبانیں ڈاؤن لوڈ نہیں ہیں۔ ترتیبات کھولیں، Apple آن ڈیوائس ترجمہ منتخب کریں، زبانیں ڈاؤن لوڈ کریں پر ٹیپ کریں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下载 %1$@ 和 %2$@ 的 Apple 翻译语言。请打开设置，选择 Apple 本地翻译，点按“下载语言”，然后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未下載 %1$@ 與 %2$@ 的 Apple 翻譯語言。請打開設定，選擇 Apple 裝置端翻譯，點一下「下載語言」，然後再試一次。"
          }
        }
      }
    },
