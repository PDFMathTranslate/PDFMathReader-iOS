    "ios.compareIPadDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم طبقة الترجمة فوق هذه الشاشة، أو افتح المستند على iPad."
          }
        },
        "arz": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم طبقة الترجمة على الشاشة دي، أو افتح المستند على iPad."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্ক্রিনে অনুবাদ ওভারলে ব্যবহার করুন, অথবা iPad-এ নথিটি খুলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Übersetzungsüberlagerung auf diesem Bildschirm oder öffnen Sie das Dokument auf einem iPad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the translation overlay on this screen, or open the document on an iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la superposición de traducción en esta pantalla o abre el documento en un iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la superposition de traduction sur cet écran ou ouvrez le document sur un iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्क्रीन पर अनुवाद ओवरले का उपयोग करें या दस्तावेज़ को iPad पर खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面で翻訳オーバーレイを使うか、iPad で書類を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 번역 오버레이를 사용하거나 iPad에서 문서를 여세요."
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Use translation overlay for this screen, or open document for iPad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize a sobreposição de tradução neste ecrã ou abra o documento num iPad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте наложение перевода на этом экране или откройте документ на iPad."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اسکرین پر ترجمے کا اوورلے استعمال کریں، یا دستاویز iPad پر کھولیں۔"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在此屏幕使用翻译叠加层，或在 iPad 上打开文档。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在此畫面使用翻譯疊加層，或在 iPad 上開啟文件。"
          }
        }
      }
    },
